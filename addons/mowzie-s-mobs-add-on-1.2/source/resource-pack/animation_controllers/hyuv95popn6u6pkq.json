{"format_version":"1.10.0","animation_controllers":{"controller.animation.hf_mzs.blowgun.use":{"initial_state":"default","states":{"default":{"transitions":[{"use":"q.is_using_item"}]},"use":{"animations":[{"fp_use":"c.is_first_person"},{"tp_use":"!c.is_first_person"}],"transitions":[{"default":"!(q.is_using_item)"}]}}},"controller.animation.hf_mzs.ice_crystal":{"initial_state":"def","states":{"def":{"animations":[{"fp_idle":"c.is_first_person"},{"tp_idle":"!c.is_first_person"}],"transitions":[{"shoot":"q.is_using_item"}]},"init":{"animations":[{"fp_using":"c.is_first_person"},{"tp_using":"!c.is_first_person"}],"transitions":[{"shoot":"q.is_using_item"}]},"shoot":{"animations":[{"fp_using":"c.is_first_person"},{"tp_using":"!c.is_first_person"}],"transitions":[{"def":"!q.is_using_item && q.any_animation_finished"}]}}},"controller.animation.hf_mzs.wroughtnaut_axe":{"initial_state":"def","states":{"def":{"animations":[{"fp_idle":"c.is_first_person"},{"tp_idle":"!c.is_first_person"}],"transitions":[{"swing":"!q.is_sneaking && c.is_first_person && q.cooldown_time_remaining('slot.weapon.mainhand')>2.9"},{"slam":"q.is_sneaking && c.is_first_person && q.cooldown_time_remaining('slot.weapon.mainhand')>2.9"}]},"slam":{"animations":["fp_slam"],"transitions":[{"def":"q.any_animation_finished || !c.is_first_person"}]},"swing":{"animations":["fp_swing"],"transitions":[{"def":"q.any_animation_finished || !c.is_first_person"}]}}}}}