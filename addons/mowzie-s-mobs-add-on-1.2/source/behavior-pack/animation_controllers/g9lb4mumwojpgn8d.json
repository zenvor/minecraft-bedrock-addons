{"format_version":"1.10.0","animation_controllers":{"controller.animation.hf_mzs.wroughtnaut.camerashake":{"states":{"awaken":{"animations":["camerashake_awaken"],"transitions":[{"default":"!q.property('hf_mzs:awaking')"}]},"death":{"animations":["camerashake_death"]},"default":{"transitions":[{"walk":"q.property('hf_mzs:state') == 'none' && q.modified_move_speed > 0.03 && !q.property('hf_mzs:sleeping') && !q.property('hf_mzs:awaking') && !q.property('hf_mzs:death')"},{"awaken":"q.property('hf_mzs:awaking')"},{"death":"q.property('hf_mzs:death')"}]},"walk":{"animations":["camerashake_walk"],"transitions":[{"default":"q.modified_move_speed < 0.03"}]}}},"controller.animation.hf_mzs.wroughtnaut.main":{"states":{"default":{"transitions":[{"freeze":"q.property('hf_mzs:state') != 'none'"}]},"freeze":{"transitions":[{"default":"(1.0)"}]}}},"controller.animation.hf_mzs.wroughtnaut.regen":{"states":{"default":{"transitions":[{"in_combat":"q.has_target"}]},"heal":{"on_entry":["/effect @s regeneration 1 20 true"],"transitions":[{"default":"q.state_time >= 0.1"}]},"in_combat":{"transitions":[{"out_of_combat":"!q.has_target"}]},"out_of_combat":{"transitions":[{"in_combat":"q.has_target"},{"heal":"q.state_time >= 20.0"}]}}},"controller.animation.hf_mzs.wroughtnaut.stop":{"states":{"attack":{"on_exit":["/effect @s slowness 4 100 true"],"transitions":[{"default":"(1.0)"}]},"default":{"transitions":[{"attack":"q.property('hf_mzs:state') == 'attacking'"},{"else":"q.property('hf_mzs:state') != 'attacking' && q.property('hf_mzs:state') != 'preparing_attack'"}]},"else":{"transitions":[{"default":"(1.0)"}]}}}}}