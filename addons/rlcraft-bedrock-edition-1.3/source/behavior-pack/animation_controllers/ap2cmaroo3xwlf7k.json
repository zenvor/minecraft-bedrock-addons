{"format_version":"1.10.0","animation_controllers":{"controller.animation.mining_skills":{"states":{"default":{"transitions":[{"equip":"q.property('hfrlc:mining_unlock')>=20"}]},"equip":{"on_entry":["@s hfrlc:mining_skills"],"transitions":[{"default":"q.property('hfrlc:mining_unlock')>=20"}]}}},"controller.animation.systemLevelDeath":{"states":{"default":{"transitions":[{"unequip":"!q.is_alive"}]},"unequip":{"on_entry":["@s hfrlc:systemLevelDeath"],"transitions":[{"default":"q.is_alive"}]}}},"controller.animation.system_level_equip":{"states":{"default":{"transitions":[{"equip":"q.get_equipped_item_name=='system_level'&&q.property('hfrlc:using_systemlevel')"}]},"equip":{"on_entry":["@s hfrlc:movementDetect"],"on_exit":["@s hfrlc:movementDetect"],"transitions":[{"default":"q.get_equipped_item_name=='system_level'&&q.property('hfrlc:using_systemlevel')"}]}}},"controller.animation.system_level_unequip":{"states":{"default":{"transitions":[{"unequip":"q.get_equipped_item_name=='system_level'&&q.property('hfrlc:using_systemlevel')"}]},"unequip":{"on_exit":["@s hfrlc:desactive_system_level"],"transitions":[{"default":"q.get_equipped_item_name!='system_level'"}]}}},"controller.animation.trident_unlock":{"states":{"default":{"transitions":[{"var1":"q.is_tamed"}]},"var1":{"on_entry":["/kill @s"],"transitions":[{"default":"q.is_tamed"}]}}}}}