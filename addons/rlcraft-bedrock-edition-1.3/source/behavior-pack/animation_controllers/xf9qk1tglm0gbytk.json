{"format_version":"1.10.0","animation_controllers":{"controller.animation.boar":{"states":{"attack_end":{"on_entry":["@s hfrlc:movement_off"],"on_exit":["@s hfrlc:movement_on"],"transitions":[{"default":"q.state_time >= 0.75"}]},"attack_loop":{"on_entry":["@s hfrlc:movement_on"],"transitions":[{"attack_end":"q.is_delayed_attacking"}]},"attack_start":{"on_entry":["@s hfrlc:movement_off"],"transitions":[{"attack_loop":"q.state_time >= 0.25"}]},"default":{"on_entry":["@s hfrlc:movement_on"],"transitions":[{"attack_start":"q.property('hfrlc:can_attack') && q.has_target"}]}}}}}