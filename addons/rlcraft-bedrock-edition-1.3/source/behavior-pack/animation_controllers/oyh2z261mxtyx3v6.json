{"format_version":"1.10.0","animation_controllers":{"controller.animation.hfrlc.pigeon.avoiding_mobs":{"initial_state":"default","states":{"avoid":{"on_entry":["@s hfrlc:fly"],"transitions":[{"default":"!q.is_avoiding_mobs || q.property('hfrlc:flying') || q.property('hfrlc:is_death')"}]},"default":{"transitions":[{"avoid":"q.is_avoiding_mobs && !q.property('hfrlc:flying') && !q.property('hfrlc:is_death')"}]}}},"controller.animation.hfrlc.pigeon.death":{"states":{"death":{"on_entry":["@s hfrlc:start_death"]},"default":{"transitions":[{"death":"q.property('hfrlc:is_death')"}]}}},"controller.animation.hfrlc.pigeon.falling":{"initial_state":"default","states":{"default":{"transitions":[{"not_ground":"!q.is_on_ground && q.property('hfrlc:states') != 'landing' && !q.property('hfrlc:flying') && !q.property('hfrlc:is_death')"}]},"not_ground":{"on_entry":["v.posy = q.position(1);"],"transitions":[{"default":"q.is_on_ground || q.property('hfrlc:flying') || q.property('hfrlc:is_death') || q.property('hfrlc:states') == 'landing'"},{"start_fly":"(v.posy - q.position(1)) >= 4"}]},"start_fly":{"on_entry":["@s hfrlc:fly"],"transitions":[{"default":"(1.0)"}]}}},"controller.animation.hfrlc.pigeon.landing":{"initial_state":"default","states":{"default":{"transitions":[{"landing":"q.property('hfrlc:states') == 'landing'"}]},"land":{"on_entry":["@s hfrlc:land"],"transitions":[{"default":"q.state_time >= 1"}]},"landing":{"transitions":[{"default":"q.property('hfrlc:is_death')"},{"land":"q.is_on_ground"}]}}}}}