action.guidebook.adding_packs2_body=~LINEBREAK~Na túto stránku sa môžete kedykoľvek dostať z ponuky RLCraft.~LINEBREAK~ 
action.guidebook.video_explaination_body=~LINEBREAK~Ak chcete zistiť, ako sa hrá RLCraft s inými balíčkami, prejdite na YouTube a vyhľadajte: §lHoneyfrost RLCraft Ako používať balíčky~LINEBREAK~~LINEBREAK~Upozornenie:§r Hoci RLCraft zvyčajne funguje s väčšinou balíkov, netestované balíky môžu spôsobiť poruchy niektorých funkcií a pridanie príliš veľkého počtu balíkov môže viesť k spomaleniu, najmä na menších zariadeniach.~LINEBREAK~~LINEBREAK~§lUpozornenie týkajúce sa Realms:§r Servery môžu po opätovnom pripojení vynulovať alebo uzamknúť poradie vašich balíčkov. Ak to spôsobí chyby s balíčkami, ktoré ste pridali, odporúčame ich deaktivovať. §oIde o známy problém systému Realms, ktorý nemôžeme ovplyvniť.§r~LINEBREAK~ 

action.guidebook.retry_tutorial=§l§8Návod na opakované pokusy
action.guidebook.already_doing_tutorial=§cNo pozri, kto zrazu zabudol, že je po kolená v tutoriáli. Ide ti to, génius.
action.guidebook.tuto_nearby=§cDobrý pokus, ale nie. Tutoriál tu teraz nemôžeš zopakovať. Choď sa potulovať niekam inam alebo premrhaj pár minút svojho drahocenného času čakaním.
action.guidebook.be_full_health_first=§cPáni, to bol odvážny ťah, vyskúšať to v takom polomŕtvom stave. Pred použitím tohto predmetu musíš mať plné zdravie, ty génius.
translate.tutorial.crouch_to_skip=Podržte tlačidlo :_input_key.sneak:, aby ste túto scénu preskočili!
translate.tutorial.break_grass_with_knife=§cOdrež trávu nožom!
translate.tutorial.break_log_with_axe=§cRozsekni to poleno sekerou!
translate.tutorial.break_stone_with_pickaxe=§cRozbij ten kameň krumpáčom!
