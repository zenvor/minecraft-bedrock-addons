{"format_version":"1.10.0","animation_controllers":{"controller.animation.hf_rl.mosquito":{"initial_state":"default","states":{"attack":{"animations":["attack"],"blend_transition":0.2,"transitions":[{"default":"q.property('hfrlc:states') != 'attack'"}]},"death_end":{"animations":["death_end"]},"death_idle":{"animations":["death_idle"],"transitions":[{"death_end":"q.is_on_ground"}]},"death_start":{"animations":["death_start"],"transitions":[{"death_idle":"q.all_animations_finished"}]},"default":{"animations":[{"idle":"q.property('hfrlc:states') != 'death' && !q.property('hfrlc:is_death')"}],"blend_transition":0.5,"transitions":[{"fly":"q.modified_move_speed >= 0.1 && q.property('hfrlc:states') == 'none'"},{"attack":"q.property('hfrlc:states') == 'attack'"},{"death_start":"q.property('hfrlc:states') == 'death' || q.property('hfrlc:is_death')"}]},"fly":{"animations":["fly"],"blend_transition":0.5,"transitions":[{"default":"q.modified_move_speed < 0.1 || q.property('hfrlc:states') != 'none'"}]}}}}}