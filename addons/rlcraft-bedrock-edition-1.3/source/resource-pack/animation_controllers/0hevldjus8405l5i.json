{"format_version":"1.10.0","animation_controllers":{"controller.animation.hf_rl.big_bad_fish":{"initial_state":"default","states":{"attack":{"animations":["attack"],"transitions":[{"death":"q.property('hfrlc:states') == 'death' || q.property('hfrlc:is_death')"},{"default":"q.all_animations_finished || q.property('hfrlc:states') != 'none'"}]},"death":{"animations":["death_start"],"transitions":[{"death_idle":"q.all_animations_finished"}]},"death_end":{"animations":["death_end"]},"death_idle":{"animations":["death_idle"],"transitions":[{"death_end":"q.is_on_ground"}]},"default":{"blend_transition":0.2,"transitions":[{"death":"q.property('hfrlc:states') == 'death' || q.property('hfrlc:is_death')"},{"attack":"q.is_delayed_attacking && q.property('hfrlc:states') == 'none'"}]}}},"controller.animation.hf_rl.big_bad_fish_walk":{"initial_state":"default","states":{"default":{"animations":[{"idle":"q.property('hfrlc:states') != 'death' && !q.property('hfrlc:is_death')"}],"blend_transition":0.2,"transitions":[{"sprint":"query.modified_move_speed >= 0.1 && q.has_target && q.property('hfrlc:states') != 'death' && !q.property('hfrlc:is_death')"},{"walk":"query.modified_move_speed >= 0.1 && !q.has_target && q.property('hfrlc:states') != 'death' && !q.property('hfrlc:is_death')"}]},"sprint":{"animations":["sprint"],"blend_transition":0.2,"transitions":[{"walk":"query.modified_move_speed >= 0.1 && !q.has_target && q.property('hfrlc:states') != 'death' && !q.property('hfrlc:is_death')"},{"default":"query.modified_move_speed < 0.1 || q.property('hfrlc:states') == 'death' || q.property('hfrlc:is_death') || !q.has_target"}]},"walk":{"animations":["walk"],"blend_transition":0.2,"transitions":[{"sprint":"query.modified_move_speed >= 0.1 && q.has_target && q.property('hfrlc:states') != 'death' && !q.property('hfrlc:is_death')"},{"default":"query.modified_move_speed < 0.1 || q.property('hfrlc:states') == 'death' || q.property('hfrlc:is_death') || q.has_target"}]}}}}}