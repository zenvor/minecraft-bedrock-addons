{"format_version":"1.10.0","animation_controllers":{"controller.animation.dead_shooter":{"initial_state":"idle","states":{"backward_roll":{"animations":[{"backward_roll":"!q.property('hfrlc:stuck')"},{"backward_roll_failed":"q.property('hfrlc:stuck')"}],"transitions":[{"idle":"!q.property('hfrlc:stuck') && q.state_time >= 1.5"},{"backward_roll_failed_Idle":"q.property('hfrlc:stuck') && q.state_time >= 1.83"},{"death":"!q.property('hfrlc:stuck') && q.property('hfrlc:dead')"},{"backward_roll_failed_to_die":"q.property('hfrlc:stuck') && q.property('hfrlc:dead')"}]},"backward_roll_failed_Idle":{"animations":["backward_roll_failed_Idle"],"blend_transition":0.2,"transitions":[{"backward_roll_failed_to_idle":"!q.property('hfrlc:stuck') && q.state_time >= 1.08"},{"backward_roll_failed_to_die":"q.property('hfrlc:dead')"}]},"backward_roll_failed_to_die":{"animations":["backward_roll_failed_to_die"],"blend_transition":0.2},"backward_roll_failed_to_idle":{"animations":["backward_roll_failed_to_idle"],"blend_transition":0.2,"transitions":[{"idle":"q.state_time >= 1.5"},{"backward_roll_failed_to_die":"q.property('hfrlc:dead')"}]},"death":{"animations":["death"],"blend_transition":0.2},"idle":{"animations":["idle"],"blend_transition":0.2,"transitions":[{"walking":"q.modified_move_speed > 0.1 && !q.has_target"},{"running":"q.modified_move_speed > 0.1 && q.has_target"},{"backward_roll":"q.property('hfrlc:state') == 'rolling'"},{"idle_look_around":"q.property('hfrlc:idle_on')"},{"load":"q.property('hfrlc:state') == 'charging'"},{"death":"q.property('hfrlc:dead')"}]},"idle_look_around":{"animations":["idle_look_around"],"blend_transition":0.2,"transitions":[{"idle":"!q.property('hfrlc:idle_on') && q.state_time >= 1.5"},{"walking":"q.modified_move_speed > 0.1 && !q.has_target"},{"backward_roll":"q.property('hfrlc:state') == 'rolling'"},{"running":"q.modified_move_speed > 0.1 && q.has_target"},{"load":"q.property('hfrlc:state') == 'charging'"},{"death":"q.property('hfrlc:dead')"}]},"loa