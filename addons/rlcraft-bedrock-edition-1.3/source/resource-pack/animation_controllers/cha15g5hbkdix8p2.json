{"format_version":"1.10.0","animation_controllers":{"controller.animation.hf_rl.sea_serpent":{"initial_state":"default","states":{"attack":{"animations":["attack_underwater"],"transitions":[{"death":"q.property('hfrlc:states') == 'death' || q.property('hfrlc:is_death')"},{"default":"!q.is_delayed_attacking || q.property('hfrlc:states') != 'none'"}]},"death":{"animations":["death"]},"default":{"blend_transition":0.2,"transitions":[{"spawn":"q.property('hfrlc:states') == 'spawn'"},{"attack":"q.is_delayed_attacking && q.property('hfrlc:states') == 'none'"},{"death":"q.property('hfrlc:states') == 'death' || q.property('hfrlc:is_death')"}]},"spawn":{"animations":["spawn"],"transitions":[{"death":"q.property('hfrlc:states') == 'death' || q.property('hfrlc:is_death')"},{"default":"q.property('hfrlc:states') != 'spawn'"}]}}},"controller.animation.hf_rl.sea_serpent_walk":{"initial_state":"default","states":{"default":{"animations":[{"idle":"q.property('hfrlc:states') != 'death' && !q.property('hfrlc:is_death')"}],"blend_transition":0.2,"transitions":[{"none":"math.abs(q.yaw_speed) > 0.2 && q.property('hfrlc:states') != 'death' && !q.property('hfrlc:is_death')"},{"walk":"query.modified_move_speed >= 0.1 && q.property('hfrlc:states') != 'spawn' && q.property('hfrlc:states') != 'death' && !q.property('hfrlc:is_death')"}]},"none":{"animations":["walk_no_tail"],"blend_transition":1,"transitions":[{"default":"math.abs(q.yaw_speed) <= 0.2 && query.modified_move_speed < 0.1 || q.property('hfrlc:states') == 'death' || q.property('hfrlc:is_death')"},{"walk":"math.abs(q.yaw_speed) <= 0.2 && query.modified_move_speed >= 0.1 && q.property('hfrlc:states') != 'spawn' && q.property('hfrlc:states') != 'death' && !q.property('hfrlc:is_death')"}]},"walk":{"animations":["walk"],"blend_transition":0.2,"transitions":[{"none":"math.abs(q.yaw_speed) > 0.2"},{"default":"query.modified_move_speed < 0.1 || q.property('hfrlc:states') == 'death' || q.property('hfrlc:is_death')"}]}}}}}