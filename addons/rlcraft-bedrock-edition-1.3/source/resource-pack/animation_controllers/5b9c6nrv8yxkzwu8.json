{"format_version":"1.10.0","animation_controllers":{"controller.animation.hippocampus":{"states":{"death":{"animations":["death"],"blend_transition":0.3},"default":{"animations":["idle"],"blend_transition":0.3,"transitions":[{"idle_with_rider":"q.has_rider"},{"swimming":"q.modified_move_speed > 0.1 && !q.has_rider"},{"swimming_fast":"q.modified_move_speed > 0.1 && q.has_rider"},{"death":"q.property('hfrlc:dead')"}]},"idle_with_rider":{"animations":["idle_with_rider"],"blend_transition":0.3,"transitions":[{"default":"!q.has_rider"},{"swimming_fast":"q.modified_move_speed > 0.1"},{"death":"q.property('hfrlc:dead')"}]},"swimming":{"animations":["swimming"],"blend_transition":0.3,"transitions":[{"default":"q.modified_move_speed <= 0.1 && !q.has_rider"},{"idle_with_rider":"q.modified_move_speed <= 0.1 && q.has_rider"},{"swimming_fast":"q.modified_move_speed > 0.1 && q.has_rider"},{"death":"q.property('hfrlc:dead')"}]},"swimming_fast":{"animations":["swimming_fast"],"blend_transition":0.3,"transitions":[{"default":"q.modified_move_speed <= 0.1 && !q.has_rider"},{"idle_with_rider":"q.modified_move_speed <= 0.1 && q.has_rider"},{"swimming":"q.modified_move_speed > 0.1 && !q.has_rider"},{"death":"q.property('hfrlc:dead')"}]}}}}}