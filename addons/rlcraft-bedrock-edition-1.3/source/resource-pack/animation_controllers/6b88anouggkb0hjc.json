{"format_version":"1.10.0","animation_controllers":{"controller.animation.hf_rl.little_ant":{"initial_state":"default","states":{"bite":{"animations":["bite"],"blend_transition":0.2,"transitions":[{"death":"q.property('hfrlc:states') == 'death' || q.property('hfrlc:is_death')"},{"default":"q.all_animations_finished || q.property('hfrlc:states') != 'none'"}]},"death":{"animations":[{"death":"q.property('hfrlc:death_type') == 0"},{"death2":"q.property('hfrlc:death_type') == 1"}]},"default":{"blend_transition":0.2,"transitions":[{"death":"q.property('hfrlc:states') == 'death' || q.property('hfrlc:is_death')"},{"summoned":"q.property('hfrlc:states') == 'summoned'"},{"bite":"q.is_delayed_attacking && q.property('hfrlc:states') == 'none'"}]},"summoned":{"animations":["summoned"],"blend_transition":0.2,"transitions":[{"death":"q.property('hfrlc:states') == 'death' || q.property('hfrlc:is_death')"},{"default":"q.property('hfrlc:states') != 'summoned'"}]}}},"controller.animation.hf_rl.little_ant_walk":{"initial_state":"default","states":{"default":{"animations":[{"idle":"(v.random == 0 || !v.random) && q.property('hfrlc:states') == 'none'"},{"idle2":"v.random == 1 && q.property('hfrlc:states') == 'none'"},{"idle3":"v.random == 2 && q.property('hfrlc:states') == 'none'"}],"blend_transition":0.2,"on_entry":["v.random = math.random_integer(0,2);"],"transitions":[{"walk":"query.modified_move_speed >= 0.1 && q.property('hfrlc:states') == 'none'"},{"loop":"q.all_animations_finished && q.property('hfrlc:states') == 'none'"}]},"loop":{"transitions":[{"default":"(1.0)"}]},"walk":{"animations":["walk"],"blend_transition":0.2,"transitions":[{"default":"query.modified_move_speed < 0.1 || q.property('hfrlc:states') != 'none'"}]}}}}}