{"format_version":"1.10.0","animation_controllers":{"controller.animation.aeris":{"initial_state":"default","states":{"attack":{"animations":[{"attack_r":"v.randomize == 1"},{"attack_l":"v.randomize == 2"}],"blend_transition":0.2,"on_entry":["v.randomize=math.random_integer(1,2);"],"transitions":[{"start_fly":"!q.is_on_ground && q.has_rider"},{"idle":"!q.is_delayed_attacking && q.modified_move_speed <= 0.1"},{"run":"!q.is_delayed_attacking && q.modified_move_speed > 0.1 && (q.has_target || q.has_rider)"},{"death":"q.property('hfrlc:dead')"}]},"death":{"animations":["death"],"blend_transition":0.2},"default":{"transitions":[{"sleep":"q.property('hfrlc:state') == 'sleeping'"},{"idle":"q.property('hfrlc:state') != 'sleeping'"}]},"fly_end":{"animations":["fly_end"],"blend_transition":0.2,"transitions":[{"start_fly":"!q.is_on_ground && q.has_rider"},{"walk":"q.state_time >= 1.79 && q.modified_move_speed > 0.1 && !q.has_target && !q.has_rider"},{"run":"q.state_time >= 1.79  && q.modified_move_speed > 0.1 && (q.has_target || q.has_rider)"},{"idle":"q.state_time >= 1.79 && q.modified_move_speed <= 0.1"},{"death":"q.property('hfrlc:dead')"}]},"fly_loop":{"animations":["fly_loop"],"blend_transition":0.2,"transitions":[{"fly_end":"q.is_on_ground"},{"death":"q.property('hfrlc:dead')"}]},"idle":{"animations":["idle"],"blend_transition":0.2,"transitions":[{"start_fly":"!q.is_on_ground && q.has_rider"},{"walk":"q.modified_move_speed > 0.1 && !q.has_target && !q.has_rider"},{"run":"q.modified_move_speed > 0.1 && (q.has_target || q.has_rider)"},{"idle_to_sleep":"q.property('hfrlc:state') == 'going_to_sleep'"},{"attack":"q.is_delayed_attacking"},{"death":"q.property('hfrlc:dead')"}]},"idle_to_sleep":{"animations":["idle_to_sleep"],"blend_transition":0.2,"transitions":[{"sleep":"q.state_time >= 2.0"}]},"run":{"animations":["run"],"blend_transition":0.2,"transitions":[{"start_fly":"!q.is_on_ground && q.has_rider"},{"idle":"q.modified_move_speed <= 0.1"},{"walk":"q.modified_move_speed >