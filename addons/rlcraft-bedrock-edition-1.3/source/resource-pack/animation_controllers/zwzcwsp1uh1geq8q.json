{"format_version":"1.10.0","animation_controllers":{"controller.animation.pumpkinkido":{"initial_state":"buried","states":{"attack":{"blend_transition":0.2,"transitions":[{"idle":"!q.is_delayed_attacking && q.modified_move_speed <= 0.1"},{"walk":"!q.is_delayed_attacking && q.modified_move_speed > 0.1"},{"death":"q.property('hfrlc:dead')"}]},"buried":{"animations":["idle_under_groung"],"transitions":[{"emerging":"q.is_emerging"},{"idle":"q.property('hfrlc:state') != 'buried'"},{"death":"q.property('hfrlc:dead')"}]},"death":{"animations":["death"],"blend_transition":0.2},"emerging":{"animations":["spawning1"],"transitions":[{"idle":"q.property('hfrlc:state') == 'emerged'"},{"death":"q.property('hfrlc:dead')"}]},"idle":{"animations":["idle_standing"],"blend_transition":0.2,"transitions":[{"idle_anim":"q.property('hfrlc:idle_on')"},{"attack":"q.is_delayed_attacking"},{"walk":"q.modified_move_speed > 0.1"},{"death":"q.property('hfrlc:dead')"}]},"idle_anim":{"animations":["idle_standing_blink"],"blend_transition":0.2,"transitions":[{"idle":"q.all_animations_finished"},{"attack":"q.is_delayed_attacking"},{"walk":"q.modified_move_speed > 0.1"},{"death":"q.property('hfrlc:dead')"}]},"walk":{"blend_transition":0.2,"transitions":[{"idle":"q.modified_move_speed < 0.1"},{"attack":"q.is_delayed_attacking"},{"death":"q.property('hfrlc:dead')"}]}}},"controller.animation.pumpkinkido.attack":{"states":{"default":{"blend_transition":0.2,"transitions":[{"right_attack":"q.is_delayed_attacking && q.property('hfrlc:attack_type') == 'right_attack'"},{"left_attack":"q.is_delayed_attacking && q.property('hfrlc:attack_type') == 'left_attack'"}]},"left_attack":{"animations":["attack_from_left_up_part"],"blend_transition":0.2,"transitions":[{"default":"!q.is_delayed_attacking"}]},"right_attack":{"animations":["attack_from_right_up_part"],"blend_transition":0.2,"transitions":[{"default":"!q.is_delayed_attacking"}]}}},"controller.animation.pumpkinkido.walk":{"states":{"default":{"blend_transition