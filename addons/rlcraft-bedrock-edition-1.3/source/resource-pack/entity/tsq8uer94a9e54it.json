{"format_version":"1.10.0","minecraft:client_entity":{"description":{"identifier":"hfrlc:player_bow","animations":{"dragon":"animation.dragon_arrow.particle","long":"animation.long_arrow.particle","move":"animation.hfrlc.longbow.flight"},"geometry":{"default":"geometry.player_arrow"},"materials":{"default":"arrow"},"particle_effects":{"fire_sword_fire":"s:bone_sword_bones","fire_sword_sheet":"s:bone_sword_sheet","fire_sword_smoke":"s:bone_sword_smoke","long_sword_sheet":"s:long_sword_sheet","long_sword_smoke":"s:long_sword_smoke"},"render_controllers":["controller.render.arrow"],"scripts":{"animate":["move",{"dragon":"!query.is_on_ground && query.is_stunned"},{"long":"!query.is_on_ground && !query.is_stunned"}],"initialize":["variable.longbow_seen_motion = 0.0;","variable.longbow_pitch = 0.0;","variable.longbow_yaw = 0.0;"],"pre_animation":["variable.longbow_dx = query.position_delta(0);","variable.longbow_dy = query.position_delta(1);","variable.longbow_dz = query.position_delta(2);","variable.longbow_horizontal_sq = variable.longbow_dx * variable.longbow_dx + variable.longbow_dz * variable.longbow_dz;","variable.longbow_moving = variable.longbow_horizontal_sq + variable.longbow_dy * variable.longbow_dy > 0.000001;","variable.longbow_pitch = variable.longbow_moving ? -math.atan2(variable.longbow_dy, math.sqrt(variable.longbow_horizontal_sq)) : (variable.longbow_seen_motion ? variable.longbow_pitch : -query.target_x_rotation);","variable.longbow_yaw = variable.longbow_horizontal_sq > 0.000001 ? math.atan2(-variable.longbow_dx, variable.longbow_dz) : (variable.longbow_seen_motion ? variable.longbow_yaw : -query.target_y_rotation);","variable.longbow_seen_motion = variable.longbow_moving ? 1.0 : variable.longbow_seen_motion;"]},"textures":{"default":"textures/entity/arrows"}}}}