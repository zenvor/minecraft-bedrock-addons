{"format_version":"1.10.0","minecraft:client_entity":{"description":{"identifier":"hfrlc:fire_arrow","animations":{"fire":"animation.fire_arrow.particle","move":"animation.hfrlc.longbow.flight"},"geometry":{"default":"geometry.hfrlc.longbow_elemental_arrow"},"materials":{"default":"arrow"},"particle_effects":{"fire_sword_fire":"hfrlc:fire","fire_sword_sheet":"s:fire_sword_sheet","fire_sword_smoke":"s:fire_sword_smoke"},"render_controllers":["controller.render.default"],"scripts":{"animate":["move",{"fire":"!query.is_on_ground"}],"initialize":["variable.longbow_seen_motion = 0.0;","variable.longbow_pitch = 0.0;","variable.longbow_yaw = 0.0;"],"pre_animation":["variable.longbow_dx = query.position_delta(0);","variable.longbow_dy = query.position_delta(1);","variable.longbow_dz = query.position_delta(2);","variable.longbow_horizontal_sq = variable.longbow_dx * variable.longbow_dx + variable.longbow_dz * variable.longbow_dz;","variable.longbow_moving = variable.longbow_horizontal_sq + variable.longbow_dy * variable.longbow_dy > 0.000001;","variable.longbow_pitch = variable.longbow_moving ? -math.atan2(variable.longbow_dy, math.sqrt(variable.longbow_horizontal_sq)) : (variable.longbow_seen_motion ? variable.longbow_pitch : -query.target_x_rotation);","variable.longbow_yaw = variable.longbow_horizontal_sq > 0.000001 ? math.atan2(-variable.longbow_dx, variable.longbow_dz) : (variable.longbow_seen_motion ? variable.longbow_yaw : -query.target_y_rotation);","variable.longbow_seen_motion = variable.longbow_moving ? 1.0 : variable.longbow_seen_motion;"]},"textures":{"default":"textures/weapon/bow/fire_dragon_bone"}}}}
