{"format_version":"1.10.0","animation_controllers":{"controller.animation.hf_fur.guide_book.item_use":{"initial_state":"default","states":{"default":{"transitions":[{"use":"q.is_using_item"}]},"use":{"animations":[{"fpp_to_page_1":"c.is_first_person"},{"tpp_to_page_1":"!c.is_first_person"}],"transitions":[{"default":"(q.any_animation_finished&&!(q.is_using_item))"}],"blend_transition":0.25}}},"controller.animation.hf_fur.guide_book.page":{"initial_state":"default","states":{"default":{"transitions":[{"use":"q.is_using_item&&!q.is_sneaking"},{"use_crouch":"q.is_using_item&&q.is_sneaking"}]},"use":{"on_entry":["v.delay=q.life_time;"],"on_exit":["v.page=math.mod((v.page+1),6);"],"transitions":[{"close":"(q.life_time-v.delay)>=1"}]},"use_crouch":{"on_entry":["v.delay=q.life_time;"],"on_exit":["v.page=v.page>0?(math.mod((v.page-1),6)):5;"],"transitions":[{"close":"(q.life_time-v.delay)>=1"}]},"close":{"transitions":[{"default":"!query.is_using_item"}]}}}}}