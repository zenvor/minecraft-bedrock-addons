item.4ks_bop:bop_book.name=Biomes O' Plenty Guidebook
guidebook.main_page.title=Biomes O' Plenty
guidebook.main_page.body=Biomes O' Plenty adds 52 naturally generating biomes to your Minecraft world! Enjoy new and unique biomes with a vanilla-esque flair along with new plants, flowers, trees, building blocks, and more!
guidebook.button.back=Back
guidebook.overworld.title=Overworld Biomes
guidebook.main_page.overworld.name=Overworld Biomes
guidebook.main_page.settings.name=Settings
guidebook.button.submit=Submit
guidebook.main_page.whatsnext.name=What's New?
guidebook.whatsnext.title=What's New?
guidebook.whatsnext.body=§l§bUPDATE 1:§r~LINEBREAK~§lBIOME UPDATES§r~LINEBREAK~ - New Biome: Subtropics~LINEBREAK~ - New Biome: Origin Valley~LINEBREAK~ - New Biome: Wintry Origin Valley~LINEBREAK~ - New Biome: Dune Beach ~LINEBREAK~ - New Biome: Gravel Beach ~LINEBREAK~ - Removed Biome: Grassland ~LINEBREAK~ - Disabled hostile mob spawning in Auroral Garden ~LINEBREAK~ - Some balancing to biome generation odds~LINEBREAK~~LINEBREAK~§lNEW BLOCKS/FUNCTIONALITY§r ~LINEBREAK~ - Village Generation! ~LINEBREAK~ - Buttons ~LINEBREAK~ - Pressure Plates ~LINEBREAK~ - Bone meal flowers to generate more around them ~LINEBREAK~ - Can now bone meal Flower Buds, Toadstools, and Glowshrooms ~LINEBREAK~ - Compostable plants and flowers ~LINEBREAK~ - Boats act like boats, not mobs ~LINEBREAK~ - Stonecutter behavior for sandstone blocks ~LINEBREAK~ - Flammable plants ~LINEBREAK~ - Map Colors added to biomes/blocks~LINEBREAK~~LINEBREAK~§lBUG FIXES/IMPROVEMENTS: §r ~LINEBREAK~ - Laggy blocks fixed in the Overgrown Greens ~LINEBREAK~ - Improved outcomes for saplings (no more fallen logs/bushes) ~LINEBREAK~ - Sound fixes for many blocks ~LINEBREAK~ - Slab behavior improved and no longer causes issues with directional blocks being placed on them ~LINEBREAK~ - Fence connectivity visual and functional improvements ~LINEBREAK~ - Leaf Decay for WIllow Trees ~LINEBREAK~ - Shears break leaves instantly ~LINEBREAK~ - Hoes can now break leaves correctly (and with enchants) ~LINEBREAK~ - Un-waterlogging a custom block will no longer delete your bucket ~LINEBREAK~ - Custom doors improved interactions with water and mobs ~LINEBREAK~ - Better organized various blocks in the creative menu (logs notably) ~LINEBREAK~ - Sprouts and clovers break if the block below them breaks ~LINEBREAK~ - Added all the vanilla biomes to the guidebook 'Current Biome:' feature
guidebook.current_biome.body=§lCurrent Biome: §r§b%s§r
guidebook.line_break=~LINEBREAK~
