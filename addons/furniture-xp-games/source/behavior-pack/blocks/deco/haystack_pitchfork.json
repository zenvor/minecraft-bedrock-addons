{
	"format_version": "1.21.70",
	"minecraft:block": {
		"description": {
			"identifier": "xp_furniture:haystack_pitchfork",
			"states": {
				"xp_furniture:top_piece_bit": [0, 1]
			},
			"traits": {
				"minecraft:placement_direction": {
					"enabled_states": ["minecraft:cardinal_direction"]
				}
			},
			"menu_category": {
				"category": "items"
			}
		},
		"components": {
			"minecraft:map_color": "#C1A137",

			"minecraft:item_visual": {
				"geometry": "geometry.xp_furniture.haystack_pitchfork_icon",
				"material_instances": {
					"*": {
						"render_method": "alpha_test",
						"texture": "xp_furniture:haystack_pitchfork"
					}
				}
			},

			"minecraft:destructible_by_explosion": {
				"explosion_resistance": 0.6
			},
			"minecraft:destructible_by_mining": {
				"seconds_to_destroy": 0.9,
				"item_specific_speeds": [
					{
						"item": { "tags": "q.any_tag('minecraft:is_hoe')" },
						"destroy_speed": 0.15
					}
				]
			},
			"minecraft:destruction_particles": {
				"texture": "hayblock_top"
			},

			"minecraft:loot": "loot_tables/empty.json",

			"xp_furniture:multiblock": {
				"size": [1, 2, 1],
				"rotate": true,
				"index": "xp_furniture:top_piece_bit"
			},
			"tag:minecraft:is_hoe_item_destructible": {}
		},
		"permutations": [
			{
				"condition": "query.block_state('xp_furniture:top_piece_bit') == 0",
				"components": {
					"minecraft:geometry": "geometry.xp_furniture.haystack_pitchfork_bottom",
					"minecraft:material_instances": {
						"*": {
							"render_method": "alpha_test",
							"texture": "xp_furniture:haystack_pitchfork"
						}
					},

					"minecraft:selection_box": true,
					"minecraft:collision_box": true
				}
			},
			{
				"condition": "query.block_state('xp_furniture:top_piece_bit') == 1",
				"components": {
					"minecraft:geometry": "geometry.xp_furniture.haystack_pitchfork_top",
					"minecraft:material_instances": {
						"*": {
							"render_method": "alpha_test",
							"texture": "xp_furniture:haystack_pitchfork"
						}
					},

					"minecraft:selection_box": {
						"origin": [-4, 0, -4],
						"size": [8, 16, 8]
					},
					"minecraft:collision_box": false
				}
			},

			{
				"condition": "query.block_state('minecraft:cardinal_direction') == 'south'",
				"components": {
					"minecraft:transformation": {
						"rotation": [0, 0, 0]
					}
				}
			},
			{
				"condition": "query.block_state('minecraft:cardinal_direction') == 'west'",
				"components": {
					"minecraft:transformation": {
						"rotation": [0, 270, 0]
					}
				}
			},
			{
				"condition": "query.block_state('minecraft:cardinal_direction') == 'north'",
				"components": {
					"minecraft:transformation": {
						"rotation": [0, 180, 0]
					}
				}
			},
			{
				"condition": "query.block_state('minecraft:cardinal_direction') == 'east'",
				"components": {
					"minecraft:transformation": {
						"rotation": [0, 90, 0]
					}
				}
			}
		]
	}
}
