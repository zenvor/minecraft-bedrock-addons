{
	"format_version": "1.21.80",
	"minecraft:block": {
		"description": {
			"identifier": "xp_furniture:piano",
			"states": {
				"xp_furniture:width_piece": [0, 1]
			},
			"traits": {
				"minecraft:placement_direction": {
					"enabled_states": ["minecraft:cardinal_direction"]
				}
			}
		},
		"components": {
			"minecraft:map_color": "#745A36",

			"minecraft:geometry": "geometry.xp_furniture.piano_left",
			"minecraft:material_instances": {
				"*": {
					"texture": "xp_furniture:piano"
				}
			},

			"minecraft:collision_box": {
				"origin": [-8, 0, -8],
				"size": [16, 11, 16]
			},
			"minecraft:selection_box": {
				"origin": [-8, 0, -8],
				"size": [16, 11, 16]
			},

			"minecraft:destructible_by_explosion": {
				"explosion_resistance": 3
			},
			"minecraft:destructible_by_mining": {
				"seconds_to_destroy": 3,
				"item_specific_speeds": [
					{
						"item": { "tags": "q.any_tag('minecraft:is_axe')" },
						"destroy_speed": 0.5
					}
				]
			},

			"minecraft:loot": "loot_tables/empty.json",

			"xp_furniture:multiblock": {
				"size": [2, 1, 1],
				"rotate": false,
				"index": "xp_furniture:width_piece"
			},
			"xp_furniture:piano": {},
			"tag:minecraft:is_axe_item_destructible": {}
		},
		"permutations": [
			{
				"condition": "query.block_state('xp_furniture:width_piece') == 0",
				"components": {
					"minecraft:geometry": "geometry.xp_furniture.piano_left"
				}
			},
			{
				"condition": "query.block_state('xp_furniture:width_piece') == 1",
				"components": {
					"minecraft:geometry": "geometry.xp_furniture.piano_right"
				}
			},
			{
				"condition": "query.block_state('minecraft:cardinal_direction') == 'south'",
				"components": {
					"minecraft:transformation": {
						"rotation": [0, 0, 0]
					}
				}
			},
			{
				"condition": "query.block_state('minecraft:cardinal_direction') == 'west'",
				"components": {
					"minecraft:transformation": {
						"rotation": [0, 270, 0]
					}
				}
			},
			{
				"condition": "query.block_state('minecraft:cardinal_direction') == 'north'",
				"components": {
					"minecraft:transformation": {
						"rotation": [0, 180, 0]
					}
				}
			},
			{
				"condition": "query.block_state('minecraft:cardinal_direction') == 'east'",
				"components": {
					"minecraft:transformation": {
						"rotation": [0, 90, 0]
					}
				}
			}
		]
	}
}
