{
	"format_version": "1.20.50",
	"minecraft:block": {
		"description": {
			"identifier": "xp_furniture:chandelier_v2",
			"traits": {
				"minecraft:placement_direction": {
					"y_rotation_offset": 180,
					"enabled_states": ["minecraft:cardinal_direction"]
				}
			},
			"states": {
				"xp_furniture:lit": [0, 1],
				"xp_furniture:is_placed": [0, 1]
			},
			"menu_category": {
				"category": "items"
			}
		},
		"components": {
			"minecraft:material_instances": {
				"*": {
					"texture": "xp_furniture:chandelier",
					"render_method": "alpha_test",
					"ambient_occlusion": true,
					"face_dimming": true
				}
			},

			"minecraft:collision_box": {
				"origin": [-8, 0, -8],
				"size": [16, 11, 16]
			},
			"minecraft:selection_box": {
				"origin": [-8, 0, -8],
				"size": [16, 11, 16]
			},

			"minecraft:destructible_by_explosion": {
				"explosion_resistance": 3.5
			},
			"minecraft:destructible_by_mining": {
				"seconds_to_destroy": 5.25,
				"item_specific_speeds": [
					{
						"item": { "tags": "q.any_tag('minecraft:is_pickaxe')" },
						"destroy_speed": 0.9
					}
				]
			},

			"minecraft:display_name": "tile.xp_furniture:chandelier.name",

			"xp_furniture:lightables_v2": {},
			"tag:minecraft:is_pickaxe_item_destructible": {}
		},
		"permutations": [
			{
				"condition": "!query.block_state('xp_furniture:is_placed')",
				"components": {
					"minecraft:geometry": "geometry.xp_furniture.chandelier_icon"
				}
			},
			{
				"condition": "!q.block_state('xp_furniture:lit') && query.block_state('xp_furniture:is_placed')",
				"components": {
					"minecraft:geometry": "geometry.xp_furniture.chandelier",
					"minecraft:light_emission": 0
				}
			},
			{
				"condition": "q.block_state('xp_furniture:lit') && query.block_state('xp_furniture:is_placed')",
				"components": {
					"minecraft:geometry": "geometry.xp_furniture.chandelier",
					"minecraft:light_emission": 15
				}
			}
		]
	}
}
