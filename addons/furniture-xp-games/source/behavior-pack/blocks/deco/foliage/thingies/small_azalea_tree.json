{
	"format_version": "1.20.50",
	"minecraft:block": {
		"description": {
			"identifier": "xp_furniture:small_azalea_tree",
			"menu_category": {
				"category": "nature",
				"group": "itemGroup.name.flower"
			},
			"traits": {
				"minecraft:placement_direction": {
					"y_rotation_offset": 180,
					"enabled_states": ["minecraft:cardinal_direction"]
				}
			},
			"states": {
				"xp_furniture:is_placed": [false, true]
			}
		},
		"components": {
			"minecraft:map_color": "#6C8031",

			"minecraft:geometry": "geometry.xp_furniture.small_azalea_tree",
			"minecraft:material_instances": {
				"*": {
					"texture": "xp_furniture:small_azalea_tree",
					"render_method": "alpha_test",
					"ambient_occlusion": false
				}
			},

			"minecraft:collision_box": {
				"origin": [-7, 0, -7],
				"size": [14, 16, 14]
			},
			"minecraft:selection_box": {
				"origin": [-7, 0, -7],
				"size": [14, 16, 14]
			},

			"minecraft:destructible_by_explosion": {
				"explosion_resistance": 0
			},
			"minecraft:destructible_by_mining": {
				"seconds_to_destroy": 0.05
			},

			"minecraft:placement_filter": {
				"conditions": [
					{
						"allowed_faces": ["up"],
						"block_filter": [
							{
								"tags": "query.all_tags('grass', 'dirt')"
							},
							"minecraft:podzol",
							"minecraft:dirt_with_roots",
							"minecraft:moss_block",
							"xp_furniture:wet_dirt"
						]
					}
				]
			},

			"xp_furniture:placement_bound": {}
		},
		"permutations": [
			{
				"condition": "!q.block_state('xp_furniture:is_placed')",
				"components": {
					"minecraft:transformation": {
						"translation": [0, -0.5, 0]
					}
				}
			},
			{
				"condition": "q.block_state('xp_furniture:is_placed') ? q.block_state('minecraft:cardinal_direction') == 'north' : false",
				"components": {
					"minecraft:transformation": {
						"rotation": [0, 0, 0]
					}
				}
			},
			{
				"condition": "q.block_state('xp_furniture:is_placed') ? q.block_state('minecraft:cardinal_direction') == 'east' : false",
				"components": {
					"minecraft:transformation": {
						"rotation": [0, 270, 0]
					}
				}
			},
			{
				"condition": "q.block_state('xp_furniture:is_placed') ? q.block_state('minecraft:cardinal_direction') == 'south' : false",
				"components": {
					"minecraft:transformation": {
						"rotation": [0, 180, 0]
					}
				}
			},
			{
				"condition": "q.block_state('xp_furniture:is_placed') ? q.block_state('minecraft:cardinal_direction') == 'west' : false",
				"components": {
					"minecraft:transformation": {
						"rotation": [0, 90, 0]
					}
				}
			}
		]
	}
}
