{
	"format_version": "1.21.80",
	"minecraft:block": {
		"description": {
			"identifier": "xp_furniture:mushroom_cluster",
			"menu_category": {
				"category": "none",
				"is_hidden_in_commands": false
			},
			"traits": {
				"minecraft:placement_direction": {
					"enabled_states": ["minecraft:cardinal_direction"]
				}
			}
		},
		"components": {
			"minecraft:geometry": "geometry.xp_furniture.mushroom_cluster",
			"minecraft:material_instances": {
				"*": {
					"texture": "xp_furniture:mushroom_cluster",
					"render_method": "alpha_test"
				}
			},

			"minecraft:collision_box": false,
			"minecraft:selection_box": {
				"origin": [-7, 0, -7],
				"size": [14, 5, 14]
			},

			"minecraft:destructible_by_explosion": {
				"explosion_resistance": 0
			},
			"minecraft:destructible_by_mining": {
				"seconds_to_destroy": 0.05
			},

			"minecraft:flammable": true,
			"minecraft:liquid_detection": {
				"detection_rules": [
					{
						"liquid_type": "water",
						"on_liquid_touches": "popped"
					}
				]
			},
			"minecraft:loot": "loot_tables/xp/fpack/blocks/icon/mushroom_cluster.json",
			"minecraft:placement_filter": {
				"conditions": [
					{
						"allowed_faces": ["up"],
						"block_filter": [
							{
								"tags": "query.any_tag('grass', 'gravel', 'dirt', 'stone', 'wood')"
							},
							"minecraft:podzol",
							"minecraft:dirt_with_roots",
							"xp_furniture:wet_dirt"
						]
					}
				]
			},

			"xp_furniture:random_rotate": {}
		},
		"permutations": [
			{
				"condition": "query.block_state('minecraft:cardinal_direction') == 'south'",
				"components": {
					"minecraft:transformation": {
						"rotation": [0, 0, 0]
					}
				}
			},
			{
				"condition": "query.block_state('minecraft:cardinal_direction') == 'west'",
				"components": {
					"minecraft:transformation": {
						"rotation": [0, 270, 0]
					}
				}
			},
			{
				"condition": "query.block_state('minecraft:cardinal_direction') == 'north'",
				"components": {
					"minecraft:transformation": {
						"rotation": [0, 180, 0]
					}
				}
			},
			{
				"condition": "query.block_state('minecraft:cardinal_direction') == 'east'",
				"components": {
					"minecraft:transformation": {
						"rotation": [0, 90, 0]
					}
				}
			}
		]
	}
}
