          {
            "item": {
              "tags": "query.any_tag('minecraft:is_pickaxe')"
            },
            "destroy_speed": 2
          }
        ]
      },
      "xp_furniture:slab": {
      },
      "tag:minecraft:is_pickaxe_item_destructible": {
      }
    },
    "permutations": [
      {
        "condition": "q.block_state('minecraft:vertical_half') == 'top' && !q.block_state('xp_furniture:is_double')",
        "components": {
          "minecraft:collision_box": {
            "origin": [
              -8,
