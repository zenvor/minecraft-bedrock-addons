              -8
            ],
            "size": [
              16,
              8,
              16
            ]
          },
          "minecraft:selection_box": {
            "origin": [
              -8,
              8,
              -8
            ],
            "size": [
              16,
              8,
              16
            ]
          }
        }
      },
      {
        "condition": "q.block_state('minecraft:vertical_half') == 'bottom' && !q.block_state('xp_furniture:is_double')",
        "components": {
          "minecraft:collision_box": {
            "origin": [
              -8,
              0,
              -8
            ],
            "size": [
              16,
              8,
              16
            ]
          },
          "minecraft:selection_box": {
            "origin": [
              -8,
              0,
              -8
            ],
            "size": [
              16,
              8,
              16
            ]
          }
