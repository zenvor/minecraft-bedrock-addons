{
	"format_version": "1.20.50",
	"minecraft:block": {
		"description": {
			"identifier": "xp_furniture:haystack",
			"traits": {
				"minecraft:placement_position": {
					"x_rotation_offset": 180,
					"enabled_states": ["minecraft:block_face"]
				}
			},
			"menu_category": {
				"category": "items"
			}
		},
		"components": {
			"minecraft:map_color": "#C1A137",

			"minecraft:geometry": "geometry.xp_furniture.haystack",
			"minecraft:material_instances": {
				"*": {
					"texture": "xp_furniture:haystack",
					"render_method": "alpha_test"
				}
			},

			"minecraft:destructible_by_explosion": {
				"explosion_resistance": 0.6
			},
			"minecraft:destructible_by_mining": {
				"seconds_to_destroy": 0.9,
				"item_specific_speeds": [
					{
						"item": { "tags": "q.any_tag('minecraft:is_hoe')" },
						"destroy_speed": 0.15
					}
				]
			},

			"minecraft:flammable": true,

			"tag:minecraft:is_hoe_item_destructible": {}
		},
		"permutations": [
			{
				"condition": "query.block_state('minecraft:block_face') == 'north'",
				"components": {
					"minecraft:transformation": {
						"rotation": [-90, 0, 0]
					}
				}
			},
			{
				"condition": "query.block_state('minecraft:block_face') == 'east'",
				"components": {
					"minecraft:transformation": {
						"rotation": [0, 0, -90]
					}
				}
			},

			{
				"condition": "query.block_state('minecraft:block_face') == 'south'",
				"components": {
					"minecraft:transformation": {
						"rotation": [90, 0, 0]
					}
				}
			},
			{
				"condition": "query.block_state('minecraft:block_face') == 'west'",
				"components": {
					"minecraft:transformation": {
						"rotation": [0, 0, 90]
					}
				}
			},
			{
				"condition": "query.block_state('minecraft:block_face') == 'up'",
				"components": {
					"minecraft:transformation": {
						"rotation": [0, 0, 0]
					}
				}
			},
			{
				"condition": "query.block_state('minecraft:block_face') == 'down'",
				"components": {
					"minecraft:transformation": {
						"rotation": [0, 0, 0]
					}
				}
			}
		]
	}
}
