				"index": "xp_furniture:multiblock_part"
			},
			"xp_furniture:tile_entity": {
				"entity": "xp_furniture:barred_door",
				"multiblockIndex": "xp_furniture:multiblock_part",
				"multiblockSize": [2, 3, 1]
			},
			"tag:minecraft:is_axe_item_destructible": {}
		},
		"permutations": [


