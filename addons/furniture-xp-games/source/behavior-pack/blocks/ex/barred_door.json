				"condition": "!q.block_state('xp_furniture:has_collision')",
				"components": {
					"minecraft:collision_box": false
				}
			},

			{
				"condition": "q.block_state('xp_furniture:has_collision') && (q.block_state('minecraft:cardinal_direction') == 'north' || q.block_state('minecraft:cardinal_direction') == 'south')",
				"components": {
					"minecraft:collision_box": {
						"origin": [-8, 0, -1.5],
						"size": [16, 16, 3]
					}
				}
			},
			{
				"condition": "q.block_state('xp_furniture:has_collision') && (q.block_state('minecraft:cardinal_direction') == 'west' || q.block_state('minecraft:cardinal_direction') == 'east')",
				"components": {
					"minecraft:collision_box": {
						"origin": [-1.5, 0, -8],
						"size": [3, 16, 16]
					}
				}
			},



			{
				"condition": "q.block_state('xp_furniture:has_collision') && (q.block_state('minecraft:cardinal_direction') == 'north' || q.block_state('minecraft:cardinal_direction') == 'south')",
				"components": {
					"minecraft:selection_box": {
						"origin": [-8, 0, -1.5],
						"size": [16, 16, 3]
					}
				}
			},
			{
				"condition": "q.block_state('xp_furniture:has_collision') && (q.block_state('minecraft:cardinal_direction') == 'west' || q.block_state('minecraft:cardinal_direction') == 'east')",
				"components": {
					"minecraft:selection_box": {
						"origin": [-1.5, 0, -8],
						"size": [3, 16, 16]
					}
				}
			},


			{
				"condition": "!q.block_state('xp_furniture:has_collision') && !q.block_state('xp_furniture:is_reversed') && q.block_state('minecraft:cardinal_direction') == 'north'",
				"components": {
					"minecraft:selection_box": {
						"origin": [5, 0, -8],
						"size": [3, 16, 9.5]
					}
				}
			},
			{
				"condition": "!q.block_state('xp_furniture:has_collision') && !q.block_state('xp_furniture:is_reversed') && q.block_state('minecraft:cardinal_direction') == 'south'",
				"components": {
					"minecraft:selection_box": {
						"origin": [-8, 0, -1.5],
						"size": [3, 16, 9.5]
					}
				}
			},
			{
				"condition": "!q.block_state('xp_furniture:has_collision') && !q.block_state('xp_furniture:is_reversed') && q.block_state('minecraft:cardinal_direction') == 'west'",
				"components": {
					"minecraft:selection_box": {
						"origin": [-1.5, 0, 5],
						"size": [9.5, 16, 3]
					}
				}
			},
			{
				"condition": "!q.block_state('xp_furniture:has_collision') && !q.block_state('xp_furniture:is_reversed') && q.block_state('minecraft:cardinal_direction') == 'east'",
				"components": {
					"minecraft:selection_box": {
						"origin": [-8, 0, -8],
						"size": [9.5, 16, 3]
					}
				}
			},

			{
				"condition": "!q.block_state('xp_furniture:has_collision') && q.block_state('xp_furniture:is_reversed') && q.block_state('minecraft:cardinal_direction') == 'north'",
				"components": {
					"minecraft:selection_box": {
						"origin": [5, 0, -1.5],
						"size": [3, 16, 9.5]
					}
				}
			},
			{
				"condition": "!q.block_state('xp_furniture:has_collision') && q.block_state('xp_furniture:is_reversed') && q.block_state('minecraft:cardinal_direction') == 'south'",
				"components": {
					"minecraft:selection_box": {
						"origin": [-8, 0, -8],
						"size": [3, 16, 9.5]
					}
				}
			},
			{
				"condition": "!q.block_state('xp_furniture:has_collision') && q.block_state('xp_furniture:is_reversed') && q.block_state('minecraft:cardinal_direction') == 'west'",
				"components": {
					"minecraft:selection_box": {
						"origin": [-8, 0, 5],
						"size": [9.5, 16, 3]
					}
				}
			},
			{
				"condition": "!q.block_state('xp_furniture:has_collision') && q.block_state('xp_furniture:is_reversed') && q.block_state('minecraft:cardinal_direction') == 'east'",
				"components": {
					"minecraft:selection_box": {
						"origin": [-1.5, 0, -8],
						"size": [9.5, 16, 3]
					}
				}
			},

			{
				"condition": "!q.block_state('xp_furniture:has_collision') && (q.block_state('xp_furniture:multiblock_part') == 1 || q.block_state('xp_furniture:multiblock_part') == 3 || q.block_state('xp_furniture:multiblock_part') == 5)",
				"components": {
					"minecraft:selection_box": false
				}
			}

		]
	}
