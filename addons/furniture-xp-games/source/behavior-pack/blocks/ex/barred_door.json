{
	"format_version": "1.21.100",
	"minecraft:block": {
		"description": {
			"identifier": "xp_furniture:barred_door",
			"traits": {
				"minecraft:placement_direction": {
					"enabled_states": ["minecraft:cardinal_direction"]
				}
			},
			"states": {
				"xp_furniture:multiblock_part": {
					"values": {
						"min": 0,
						"max": 5
					}
				},
				"xp_furniture:has_collision": [true, false],
				"xp_furniture:is_reversed": [false, true]
			}
		},
		"components": {
			"minecraft:map_color": "#B02E26",

			"minecraft:geometry": "geometry.xp_furniture.invisible",
			"minecraft:material_instances": {
				"*": {
					"texture": "xp_furniture:none",
					"render_method": "alpha_test",
					"ambient_occlusion": false,
					"face_dimming": false
				}
			},
			"minecraft:item_visual": {
				"geometry": "geometry.xp_furniture.barred_door_icon",
				"material_instances": {
					"*": {
						"texture": "xp_furniture:barred_door",
						"render_method": "alpha_test"
					}
				}
			},

			"minecraft:destructible_by_explosion": {
				"explosion_resistance": 3
			},
			"minecraft:destructible_by_mining": {
				"seconds_to_destroy": 3,
				"item_specific_speeds": [
					{
						"item": { "tags": "q.any_tag('minecraft:is_axe')" },
						"destroy_speed": 0.5
					}
				]
			},
			"minecraft:destruction_particles": {
				"texture": "xp_furniture:barred_door"
			},

			"minecraft:loot": "loot_tables/empty.json",
			"minecraft:movable": {
				"movement_type": "popped"
			},

			"xp_furniture:barred_door": {},
			"xp_furniture:multiblock": {
				"size": [2, 3, 1],
