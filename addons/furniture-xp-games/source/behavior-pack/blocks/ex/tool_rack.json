{
	"format_version": "1.21.100",
	"minecraft:block": {
		"description": {
			"identifier": "xp_furniture:tool_rack",
			"traits": {
				"minecraft:placement_direction": {
					"enabled_states": ["minecraft:cardinal_direction"]
				}
			},
			"menu_category": {
				"category": "items"
			}
		},
		"components": {
			"minecraft:map_color": "#614B2E",

			"minecraft:geometry": "geometry.xp_furniture.tool_rack_icon",
			"minecraft:material_instances": {
				"*": {
					"texture": "xp_furniture:none",
