{
	"format_version": "1.21.80",
	"minecraft:block": {
		"description": {
			"identifier": "xp_furniture:large_wooden_cart",
			"states": {
				"xp_furniture:head_piece_bit": [0, 1]
			},
			"traits": {
				"minecraft:placement_direction": {
					"enabled_states": ["minecraft:cardinal_direction"]
				}
			},
			"menu_category": {
				"category": "items"
			}
		},
		"components": {
			"minecraft:map_color": "#C29D62",

			"minecraft:geometry": "geometry.xp_furniture.large_wooden_cart_icon",
			"minecraft:material_instances": {
				"*": {
					"texture": "xp_furniture:large_wooden_cart",
					"render_method": "alpha_test",
					"ambient_occlusion": false
				}
			},
			"minecraft:item_visual": {
				"geometry": "geometry.xp_furniture.large_wooden_cart_icon",
				"material_instances": {
					"*": {
						"texture": "xp_furniture:large_wooden_cart",
						"render_method": "alpha_test",
						"ambient_occlusion": false
					}
				}
			},

			"minecraft:collision_box": true,

			"minecraft:destructible_by_explosion": {
				"explosion_resistance": 3
			},
			"minecraft:destructible_by_mining": {
				"seconds_to_destroy": 3,
				"item_specific_speeds": [
					{
						"item": { "tags": "q.any_tag('minecraft:is_axe')" },
						"destroy_speed": 0.5
					}
				]
			},

			"minecraft:loot": "loot_tables/empty.json",

			"xp_furniture:multiblock": {
				"size": [1, 1, 2],
				"rotate": true,
				"index": "xp_furniture:head_piece_bit"
			},
			"tag:minecraft:is_axe_item_destructible": {}
		},
		"permutations": [
			{
				"condition": "query.block_state('xp_furniture:head_piece_bit') == 0",
				"components": {
					"minecraft:geometry": "geometry.xp_furniture.large_wooden_cart_front"
				}
			},
			{
				"condition": "query.block_state('xp_furniture:head_piece_bit') == 1",
				"components": {
					"minecraft:geometry": "geometry.xp_furniture.large_wooden_cart_back"
				}
			},
			{
				"condition": "query.block_state('minecraft:cardinal_direction') == 'south'",
				"components": {
					"minecraft:transformation": {
						"rotation": [0, 0, 0]
					}
				}
			},
			{
				"condition": "query.block_state('minecraft:cardinal_direction') == 'west'",
				"components": {
					"minecraft:transformation": {
						"rotation": [0, 270, 0]
					}
				}
			},
			{
				"condition": "query.block_state('minecraft:cardinal_direction') == 'north'",
				"components": {
					"minecraft:transformation": {
						"rotation": [0, 180, 0]
					}
				}
			},
			{
				"condition": "query.block_state('minecraft:cardinal_direction') == 'east'",
				"components": {
					"minecraft:transformation": {
						"rotation": [0, 90, 0]
					}
				}
			}
		]
	}
}
