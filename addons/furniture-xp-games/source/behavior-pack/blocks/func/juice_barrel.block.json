								"allowed_faces": ["all"],
								"block_filter": ["air"]
							}
						]
					}
				}
			},
			{
				"condition": "query.block_state('xp_furniture:multiblock_part') == 0 && query.block_state('xp_furniture:is_placed')",
				"components": {
					"minecraft:geometry": "geometry.xp_furniture.juice_barrel_back_bottom_left"
				}
			},
			{
				"condition": "query.block_state('xp_furniture:multiblock_part') == 1 && query.block_state('xp_furniture:is_placed')",
				"components": {
					"minecraft:geometry": "geometry.xp_furniture.juice_barrel_front_bottom_left"
				}
			},
			{
				"condition": "query.block_state('xp_furniture:multiblock_part') == 2 && query.block_state('xp_furniture:is_placed')",
				"components": {
					"minecraft:geometry": "geometry.xp_furniture.juice_barrel_back_bottom_right"
				}
			},
			{
				"condition": "query.block_state('xp_furniture:multiblock_part') == 3 && query.block_state('xp_furniture:is_placed')",
				"components": {
					"minecraft:geometry": "geometry.xp_furniture.juice_barrel_front_bottom_right"
				}
			},
