{
	"format_version": "1.20.50",
	"minecraft:block": {
		"description": {
			"identifier": "xp_furniture:juice_barrel",
			"menu_category": {
				"category": "none"
			},
			"states": {
				"xp_furniture:is_placed": [0, 1],
				"xp_furniture:direction": [0, 1, 2, 3],
				"xp_furniture:multiblock_part": [0, 1, 2, 3, 4, 5, 6, 7]
			}
		},
		"components": {
			"minecraft:map_color": "#806039",

			"minecraft:material_instances": {
				"*": {
