				"condition": "query.block_state('xp_furniture:multiblock_part') == 4 && query.block_state('xp_furniture:is_placed')",
				"components": {
					"minecraft:geometry": "geometry.xp_furniture.juice_barrel_back_top_left"
				}
			},
			{
				"condition": "query.block_state('xp_furniture:multiblock_part') == 5 && query.block_state('xp_furniture:is_placed')",
				"components": {
					"minecraft:geometry": "geometry.xp_furniture.juice_barrel_front_top_left"
				}
			},
			{
				"condition": "query.block_state('xp_furniture:multiblock_part') == 6 && query.block_state('xp_furniture:is_placed')",
				"components": {
					"minecraft:geometry": "geometry.xp_furniture.juice_barrel_back_top_right"
				}
			},
			{
				"condition": "query.block_state('xp_furniture:multiblock_part') == 7 && query.block_state('xp_furniture:is_placed')",
				"components": {
					"minecraft:geometry": "geometry.xp_furniture.juice_barrel_front_top_right"
