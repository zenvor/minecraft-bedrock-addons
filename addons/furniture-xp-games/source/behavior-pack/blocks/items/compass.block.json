{
	"format_version": "1.20.50",
	"minecraft:block": {
		"description": {
			"identifier": "xp_furniture:compass",
			"traits": {
				"minecraft:placement_direction": {
					"y_rotation_offset": 180,
					"enabled_states": ["minecraft:cardinal_direction"]
				},
				"minecraft:placement_position": {
					"enabled_states": ["minecraft:block_face"]
				}
			},
			"menu_category": {
				"category": "items"
			}
		},
		"components": {
			"minecraft:material_instances": {
				"*": {
					"texture": "xp_furniture:compass",
					"render_method": "alpha_test",
					"ambient_occlusion": false
				}
			},

			"minecraft:destructible_by_explosion": {
				"explosion_resistance": 0.0
			},
			"minecraft:destructible_by_mining": {
				"seconds_to_destroy": 0.05
			}
		},
		"permutations": [
			{
				"condition": "query.block_state('minecraft:block_face') == 'up' || query.block_state('minecraft:block_face') == 'down'",
				"components": {
					"minecraft:geometry": "geometry.xp_furniture.compass_sitting",
					"minecraft:collision_box": {
						"origin": [-3.5, 0, -3.5],
						"size": [7, 3.2, 7]
					},
					"minecraft:selection_box": {
						"origin": [-3.5, 0, -3.5],
						"size": [7, 3.2, 7]
					}
				}
			},
			{
				"condition": "(query.block_state('minecraft:block_face') == 'north' || query.block_state('minecraft:block_face') == 'east' || query.block_state('minecraft:block_face') == 'south' || query.block_state('minecraft:block_face') == 'west')",
				"components": {
					"minecraft:geometry": "geometry.xp_furniture.compass_hanging",
					"minecraft:collision_box": {
						"origin": [-3.5, 4.5, 4.8],
						"size": [7, 7, 3.2]
					},
					"minecraft:selection_box": {
						"origin": [-3.5, 4.5, 4.8],
						"size": [7, 7, 3.2]
					}
				}
			},
			{
				"condition": "query.block_state('minecraft:block_face') == 'north'",
				"components": {
					"minecraft:transformation": {
						"rotation": [0, 0, 0]
					}
				}
			},
			{
				"condition": "query.block_state('minecraft:block_face') == 'east'",
				"components": {
					"minecraft:transformation": {
						"rotation": [0, 270, 0]
					}
				}
			},
			{
				"condition": "query.block_state('minecraft:block_face') == 'south'",
				"components": {
					"minecraft:transformation": {
						"rotation": [0, 180, 0]
					}
				}
			},
			{
				"condition": "query.block_state('minecraft:block_face') == 'west'",
				"components": {
					"minecraft:transformation": {
						"rotation": [0, 90, 0]
					}
				}
			},
			{
				"condition": "query.block_state('minecraft:cardinal_direction') == 'north' && (query.block_state('minecraft:block_face') == 'up' || query.block_state('minecraft:block_face') == 'down')",
				"components": {
					"minecraft:transformation": {
						"rotation": [0, 0, 0]
					}
				}
			},
			{
				"condition": "query.block_state('minecraft:cardinal_direction') == 'east' && (query.block_state('minecraft:block_face') == 'up' || query.block_state('minecraft:block_face') == 'down')",
				"components": {
					"minecraft:transformation": {
						"rotation": [0, 270, 0]
					}
				}
			},
			{
				"condition": "query.block_state('minecraft:cardinal_direction') == 'south' && (query.block_state('minecraft:block_face') == 'up' || query.block_state('minecraft:block_face') == 'down')",
				"components": {
					"minecraft:transformation": {
						"rotation": [0, 180, 0]
					}
				}
			},
			{
				"condition": "query.block_state('minecraft:cardinal_direction') == 'west' && (query.block_state('minecraft:block_face') == 'up' || query.block_state('minecraft:block_face') == 'down')",
				"components": {
					"minecraft:transformation": {
						"rotation": [0, 90, 0]
					}
				}
			}
		]
	}
}
