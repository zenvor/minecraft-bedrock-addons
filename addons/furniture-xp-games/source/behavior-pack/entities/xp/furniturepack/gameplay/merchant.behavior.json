{
	"format_version": "1.20.50",
	"minecraft:entity": {
		"description": {
			"identifier": "xp_furniture:merchant",
			"is_spawnable": true,
			"is_summonable": true,
			"is_experimental": false,
			"properties": {
				"xp_furniture:is_leader": {
					"type": "bool",
					"default": false
				},

				"xp_furniture:is_season": {
					"type": "enum",
					"default": "none",
					"values": ["none", "christmas"],
					"client_sync": true
				}
			}
		},

		"component_groups": {
			"xp_furniture:start_despawning": {
				"minecraft:type_family": {
					"family": [
						"xp_furniture",
						"furniture",
						"furniture_despawning"
					]
				}
			},

			"xp_furniture:set_normal_trades": {
				"minecraft:transformation": {
					"into": "xp_furniture:merchant<xp_furniture:normal_trades>"
				}
			},
			"xp_furniture:normal_trades": {
				"minecraft:economy_trade_table": {
					"display_name": "entity.xp_furniture:merchant.name",
					"table": "trading/xp/fpack/merchant/default.json",
					"new_screen": true
				}
			},

			"xp_furniture:set_christmas_trades": {
				"minecraft:transformation": {
					"into": "xp_furniture:merchant<xp_furniture:christmas_trades>"
				}
			},
			"xp_furniture:christmas_trades": {
				"minecraft:economy_trade_table": {
					"display_name": "entity.xp_furniture:merchant.name",
					"table": "trading/xp/fpack/merchant/christmas.json",
					"new_screen": true
				}
			}
		},

		"components": {
			"minecraft:behavior.avoid_mob_type": {
				"priority": 2,
				"ignore_visibility": false,
				"entity_types": [
					{
						"filters": {
							"any_of": [
								{
									"test": "is_family",
									"subject": "other",
									"value": "monster"
								}
							]
						},
						"walk_speed_multiplier": 1.2,
						"sprint_speed_multiplier": 1.5
					}
				],
				"max_flee": 32,
				"max_dist": 64
			},
			"minecraft:timer": {
				"looping": false,
				"random_time_choices": [
					{ "weight": 50, "value": 300 },
					{ "weight": 50, "value": 420 }
				],
				"time_down_event": {
					"event": "xp_furniture:start_despawning",
					"target": "self"
				}
			},
			"minecraft:behavior.panic": {
				"damage_sources": ["all"],
				"speed_multiplier": 2.5,
				"force": false,
				"ignore_mob_damage": false,
				"prefer_water": false,
				"panic_sound": "haggle.idle",
				"sound_interval": {
					"range_min": 0.1,
					"range_max": 0.2
				}
			},
			"minecraft:behavior.follow_caravan": {
				"priority": 3,
				"speed_multiplier": 1.0,
				"entity_count": 10,
				"entity_types": {
					"filters": {
						"any_of": [
							{
								"test": "is_family",
								"value": "llama"
							},
							{
								"test": "is_family",
								"value": "xp_furniture"
							}
						]
					}
				}
			},
			"minecraft:type_family": {
				"family": ["xp_furniture", "furniture"]
			},
			"minecraft:is_hidden_when_invisible": {},
			"minecraft:breathable": {
				"total_supply": 15,
				"suffocate_time": 0
			},
			"minecraft:health": {
				"value": 30,
				"max": 30
			},
			"minecraft:hurt_on_condition": {
				"damage_conditions": [
					{
						"filters": {
							"test": "in_lava",
							"subject": "self",
							"operator": "==",
							"value": true
						},
						"cause": "lava",
						"damage_per_tick": 4
					}
				]
			},
			"minecraft:collision_box": {
				"width": 0.6,
				"height": 1.9
			},
			"minecraft:movement": {
				"value": 0.135
			},
			"minecraft:despawn": {
				"remove_child_entities": true,
				"filters": {
					"all_of": [
						{
							"any_of": [
								{
									"test": "is_family",
									"subject": "self",
									"value": "furniture_despawning"
								},
								{
									"test": "has_trade_supply",
									"subject": "self",
									"value": false
								}
							]
						},
						{
							"test": "distance_to_nearest_player",
							"operator": ">",
							"value": 24
						}
					]
				}
			},
			"minecraft:navigation.walk": {
				"can_path_over_water": true,
				"can_pass_doors": true,
				"can_open_doors": false,
				"avoid_water": true
			},
			"minecraft:movement.basic": {},
			"minecraft:jump.static": {},
			"minecraft:can_climb": {},
			"minecraft:behavior.float": {
				"priority": 0
			},
			"minecraft:conditional_bandwidth_optimization": {},

			"minecraft:behavior.trade_with_player": {
				"priority": 1,
				"filters": {
					"all_of": [
						{
							"all_of": [{ "test": "in_water", "value": false }]
						},
						{
							"any_of": [
								{ "test": "on_ground", "value": true },
								{ "test": "is_sleeping", "value": true }
							]
						}
					]
				}
			},
			"minecraft:behavior.trade_interest": {
				"priority": 3,
				"within_radius": 6.0,
				"interest_time": 45.0,
				"remove_item_time": 1.0,
				"carried_item_switch_time": 2.0,
				"cooldown": 2.0
			},
			"minecraft:behavior.look_at_trading_player": {
				"priority": 4
			},
			"minecraft:behavior.random_stroll": {
				"priority": 7,
				"speed_multiplier": 1
			},
			"minecraft:behavior.look_at_player": {
				"priority": 8,
				"look_distance": 8,
				"probability": 0.02
			},
			"minecraft:behavior.random_look_around": {
				"priority": 9
			},
			"minecraft:physics": {},
			"minecraft:pushable": {
				"is_pushable": true,
				"is_pushable_by_piston": true
			},
			"minecraft:nameable": {},
			"minecraft:behavior.drink_potion": {
				"priority": 1,
				"speed_modifier": -0.2,
				"potions": [
					{
						"id": 7,
						"chance": 1.0,
						"filters": {
							"all_of": [
								{
									"any_of": [
										{
											"test": "hourly_clock_time",
											"operator": ">=",
											"value": 18000
										},
										{
											"test": "hourly_clock_time",
											"operator": "<",
											"value": 12000
										}
									]
								},
								{
									"test": "is_visible",
									"subject": "self",
									"value": true
								},
								{
									"any_of": [
										{
											"test": "is_avoiding_mobs",
											"subject": "self",
											"value": true
										},
										{
											"all_of": [
												{
													"test": "has_component",
													"subject": "self",
													"value": "minecraft:angry"
												},
												{
													"test": "is_family",
													"subject": "target",
													"operator": "!=",
													"value": "player"
												}
											]
										}
									]
								}
							]
						}
					},
					{
						"id": 8,
						"chance": 1.0,
						"filters": {
							"all_of": [
								{
									"test": "hourly_clock_time",
									"operator": ">=",
									"value": 12000
								},
								{
									"test": "hourly_clock_time",
									"operator": "<",
									"value": 18000
								},
								{
									"test": "is_visible",
									"subject": "self",
									"value": true
								},
								{
									"any_of": [
										{
											"test": "is_avoiding_mobs",
											"subject": "self",
											"value": true
										},
										{
											"test": "has_component",
											"subject": "self",
											"value": "minecraft:angry"
										}
									]
								}
							]
						}
					}
				]
			},
			"minecraft:behavior.drink_milk": {
				"priority": 5,
				"filters": {
					"all_of": [
						{ "test": "is_daytime", "value": true },
						{
							"test": "is_visible",
							"subject": "self",
							"value": false
						},
						{
							"test": "is_avoiding_mobs",
							"subject": "self",
							"value": false
						}
					]
				}
			}
		},
		"events": {
			"minecraft:entity_spawned": {
				"add": {
					"component_groups": ["xp_furniture:normal_trades"]
				}
			},

			"xp_furniture:start_despawning": {
				"add": {
					"component_groups": ["xp_furniture:start_despawning"]
				}
			},

			"xp_furniture:is_default_season": {
				"add": {
					"component_groups": ["xp_furniture:set_normal_trades"]
				}
			},
			"xp_furniture:is_christmas": {
				"add": {
					"component_groups": ["xp_furniture:set_christmas_trades"]
				}
			},

			"xp_furniture:normal_trades": {
				"add": {
					"component_groups": ["xp_furniture:normal_trades"]
				},
				"set_property": { "xp_furniture:is_season": "none" }
			},
			"xp_furniture:christmas_trades": {
				"add": {
					"component_groups": ["xp_furniture:christmas_trades"]
				},
				"set_property": { "xp_furniture:is_season": "christmas" }
			}
		}
	}
}
