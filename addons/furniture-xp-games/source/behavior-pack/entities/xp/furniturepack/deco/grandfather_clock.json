{
	"format_version": "1.20.50",
	"minecraft:entity": {
		"description": {
			"identifier": "xp_furniture:grandfather_clock",
			"is_summonable": true,
			"is_spawnable": false,

			"scripts": {
				"animate": ["unfishable"]
			},
			"animations": {
				"unfishable": "controller.animation.xp_furniture.unfishable"
			},

			"properties": {
				"xp_furniture:is_interacted_with": {
					"type": "bool",
					"default": false,
					"client_sync": true
				}
			}
		},

		"component_groups": {
			"xp_furniture:instant_despawn": {
				"minecraft:instant_despawn": {}
			},

			"xp_furniture:default": { "minecraft:variant": { "value": 0 } },
			"xp_furniture:fancy": { "minecraft:variant": { "value": 1 } },
			"xp_furniture:small": { "minecraft:variant": { "value": 2 } },
			"xp_furniture:small_fancy": { "minecraft:variant": { "value": 3 } }
		},

		"components": {
			"minecraft:fire_immune": {},
			"minecraft:type_family": {
				"family": [
					"furniture",
					"decorational",
					"grandfather_clock",
					"inanimate"
				]
			},
			"minecraft:pushable": {
				"is_pushable": false,
				"is_pushable_by_piston": false
			},
			"minecraft:collision_box": {
				"width": 0.0,
				"height": 0.0
			},
			"minecraft:health": {
				"min": 100,
				"max": 100,
				"value": 100
			},
			"minecraft:damage_sensor": {
				"triggers": {
					"cause": "all",
					"deals_damage": false
				}
			},
			"minecraft:persistent": {},
			"minecraft:physics": {
				"has_gravity": false,
				"has_collision": false,
				"push_towards_closest_space": false
			},
			"minecraft:knockback_resistance": {
				"value": 1
			},
			"minecraft:inside_block_notifier": {
				"block_list": [
					{
						"block": {
							"name": "minecraft:air"
						},
						"entered_block_event": {
							"event": "xp_furniture:despawn",
							"target": "self"
						}
					}
				]
			},
			"minecraft:is_hidden_when_invisible": {},
			"minecraft:conditional_bandwidth_optimization": {}
		},

		"events": {
			"xp_furniture:despawn": {
				"sequence": [
					{
						"filters": {
							"test": "is_variant",
							"operator": "<=",
							"value": 1
						},
						"queue_command": {
							"command": "execute rotated as @s run fill ^^^ ^^2^ air destroy"
						}
					},
					{
						"filters": {
							"test": "is_variant",
							"operator": ">",
							"value": 1
						},
						"queue_command": {
							"command": "execute rotated as @s run fill ^^^ ^^1^ air destroy"
						}
					},
					{
						"queue_command": {
							"command": "event entity @s xp_furniture:instant_despawn"
						}
					}
				]
			},
			"xp_furniture:instant_despawn": {
				"add": {
					"component_groups": ["xp_furniture:instant_despawn"]
				}
			},

			"xp_furniture:default": {
				"add": { "component_groups": ["xp_furniture:default"] }
			},
			"xp_furniture:fancy": {
				"add": { "component_groups": ["xp_furniture:fancy"] }
			},
			"xp_furniture:small": {
				"add": { "component_groups": ["xp_furniture:small"] }
			},
			"xp_furniture:small_fancy": {
				"add": { "component_groups": ["xp_furniture:small_fancy"] }
			}
		}
	}
}
