					]
				}
			},

			"xp_furniture:on_interact": {
				"minecraft:interact": {
					"interactions": {
						"on_interact": {
							"filters": {
								"all_of": [
									{
										"test": "is_family",
										"subject": "other",
										"value": "player"
									},
									{
										"none_of": [
											{
