				"remove": {
					"component_groups": ["xp_furniture:on_interact"]
				},
				"set_property": {
					"xp_furniture:is_interacted_with": false
				}
			},

			"xp_furniture:big_gold": {
				"add": { "component_groups": ["xp_furniture:big_gold"] }
			},
			"xp_furniture:big_metal": {
				"add": { "component_groups": ["xp_furniture:big_metal"] }
			},
			"xp_furniture:small_iron": {
