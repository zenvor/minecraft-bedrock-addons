									{
										"test": "bool_property",
										"domain": "xp_furniture:is_uninteractable",
										"value": false
									}
								]
							},
							"event": "xp_furniture:clear_on_interact",
							"target": "self"
						},
						"play_sounds": "extinguish.fire"
					}
				}
			},

			"xp_furniture:reset_interact": {
				"minecraft:transformation": {
					"into": "xp_furniture:candle_holder"
