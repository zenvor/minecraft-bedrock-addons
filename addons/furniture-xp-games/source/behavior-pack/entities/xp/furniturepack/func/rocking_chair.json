{
	"format_version": "1.21.100",
	"minecraft:entity": {
		"description": {
			"identifier": "xp_furniture:rocking_chair",
			"is_summonable": true,
			"is_spawnable": false,

			"scripts": {
				"animate": ["unfishable"]
			},
			"animations": {
				"unfishable": "controller.animation.xp_furniture.unfishable"
			},

			"properties": {
				"xp_furniture:is_uninteractable": {
					"type": "bool",
					"default": false,
					"client_sync": true
				},
				"xp_furniture:is_interacted_with": {
					"type": "bool",
					"default": false,
					"client_sync": true
				}
			}
		},

		"component_groups": {
			"xp_furniture:instant_despawn": {
				"minecraft:instant_despawn": {}
			},

			"xp_furniture:on_interact": {
				"minecraft:timer": {
					"time": 0.25,
					"time_down_event": {
						"event": "xp_furniture:clear_on_interact",
						"target": "self"
					}
				}
			},

			"xp_furniture:is_interactable": {
				"minecraft:rideable": {
					"family_types": ["player"],
					"seat_count": 1,
					"interact_text": "action.interact.sit",
					"seats": [{ "position": [0, 0.325, 0] }]
				}
			},

			"xp_furniture:wood_oak": {
				"minecraft:mark_variant": { "value": 0 }
			},
			"xp_furniture:wood_acacia": {
				"minecraft:mark_variant": { "value": 1 }
			},
			"xp_furniture:wood_bamboo": {
				"minecraft:mark_variant": { "value": 2 }
			},
			"xp_furniture:wood_birch": {
				"minecraft:mark_variant": { "value": 3 }
			},
			"xp_furniture:wood_cherry": {
				"minecraft:mark_variant": { "value": 4 }
			},
			"xp_furniture:wood_crimson": {
				"minecraft:mark_variant": { "value": 5 }
			},
			"xp_furniture:wood_dark_oak": {
				"minecraft:mark_variant": { "value": 6 }
			},
			"xp_furniture:wood_jungle": {
				"minecraft:mark_variant": { "value": 7 }
			},
			"xp_furniture:wood_mangrove": {
				"minecraft:mark_variant": { "value": 8 }
			},
			"xp_furniture:wood_spruce": {
				"minecraft:mark_variant": { "value": 9 }
			},
			"xp_furniture:wood_template": {
				"minecraft:mark_variant": { "value": 10 }
			},
			"xp_furniture:wood_warped": {
				"minecraft:mark_variant": { "value": 11 }
			},
			"xp_furniture:wood_pale_oak": {
				"minecraft:mark_variant": { "value": 12 }
			}
		},

		"components": {
			"minecraft:fire_immune": {},
			"minecraft:type_family": {
				"family": [
					"furniture",
					"functional",
					"rocking_chair",
					"inanimate"
				]
			},
			"minecraft:pushable": {
				"is_pushable": false,
				"is_pushable_by_piston": false
			},
			"minecraft:collision_box": {
				"width": 0.0,
				"height": 0.0
			},
			"minecraft:health": {
				"min": 1,
				"max": 1,
				"value": 1
			},
			"minecraft:damage_sensor": {
				"triggers": {
					"cause": "all",
					"deals_damage": "no"
				}
			},
			"minecraft:environment_sensor": {
				"triggers": {
					"filters": [
						{
							"test": "rider_count",
							"value": 0
						},
						{
							"test": "bool_property",
							"domain": "xp_furniture:is_interacted_with",
							"value": false
						},
						{
							"test": "bool_property",
							"domain": "xp_furniture:is_uninteractable",
							"value": false
						}
					],
					"event": "xp_furniture:on_interact",
					"target": "self"
				}
			},
			"minecraft:persistent": {},
			"minecraft:physics": {
				"has_gravity": false,
				"has_collision": false,
				"push_towards_closest_space": false
			},
			"minecraft:knockback_resistance": {
				"value": 1
			},

			"minecraft:body_rotation_always_follows_head": {},
			"minecraft:body_rotation_blocked": {},

			"minecraft:inside_block_notifier": {
				"block_list": [
					{
						"block": {
							"name": "minecraft:air"
						},
						"entered_block_event": {
							"event": "xp_furniture:despawn",
							"target": "self"
						}
					}
				]
			},

			"minecraft:is_hidden_when_invisible": {},
			"minecraft:conditional_bandwidth_optimization": {}
		},

		"events": {
			"xp_furniture:despawn": {
				"add": {
					"component_groups": ["xp_furniture:instant_despawn"]
				}
			},

			"xp_furniture:is_interactable": {
				"add": { "component_groups": ["xp_furniture:is_interactable"] },
				"remove": {
					"component_groups": ["xp_furniture:is_uninteractable"]
				}
			},
			"xp_furniture:is_uninteractable": {
				"add": {
					"component_groups": ["xp_furniture:is_uninteractable"]
				},
				"remove": {
					"component_groups": ["xp_furniture:is_interactable"]
				},
				"set_property": { "xp_furniture:is_uninteractable": true }
			},

			"xp_furniture:on_interact": {
				"add": {
					"component_groups": ["xp_furniture:on_interact"]
				},
				"set_property": {
					"xp_furniture:is_interacted_with": true
				}
			},
			"xp_furniture:clear_on_interact": {
				"remove": {
					"component_groups": ["xp_furniture:on_interact"]
				},
				"set_property": {
					"xp_furniture:is_interacted_with": false
				}
			},

			"xp_furniture:wood_oak": {
				"add": { "component_groups": ["xp_furniture:wood_oak"] },
				"trigger": "xp_furniture:is_interactable"
			},
			"xp_furniture:wood_acacia": {
				"add": { "component_groups": ["xp_furniture:wood_acacia"] },
				"trigger": "xp_furniture:is_interactable"
			},
			"xp_furniture:wood_bamboo": {
				"add": { "component_groups": ["xp_furniture:wood_bamboo"] },
				"trigger": "xp_furniture:is_interactable"
			},
			"xp_furniture:wood_birch": {
				"add": { "component_groups": ["xp_furniture:wood_birch"] },
				"trigger": "xp_furniture:is_interactable"
			},
			"xp_furniture:wood_cherry": {
				"add": { "component_groups": ["xp_furniture:wood_cherry"] },
				"trigger": "xp_furniture:is_interactable"
			},
			"xp_furniture:wood_crimson": {
				"add": { "component_groups": ["xp_furniture:wood_crimson"] },
				"trigger": "xp_furniture:is_interactable"
			},
			"xp_furniture:wood_dark_oak": {
				"add": { "component_groups": ["xp_furniture:wood_dark_oak"] },
				"trigger": "xp_furniture:is_interactable"
			},
			"xp_furniture:wood_jungle": {
				"add": { "component_groups": ["xp_furniture:wood_jungle"] },
				"trigger": "xp_furniture:is_interactable"
			},
			"xp_furniture:wood_mangrove": {
				"add": { "component_groups": ["xp_furniture:wood_mangrove"] },
				"trigger": "xp_furniture:is_interactable"
			},
			"xp_furniture:wood_spruce": {
				"add": { "component_groups": ["xp_furniture:wood_spruce"] },
				"trigger": "xp_furniture:is_interactable"
			},
			"xp_furniture:wood_template": {
				"add": { "component_groups": ["xp_furniture:wood_template"] },
				"trigger": "xp_furniture:is_interactable"
			},
			"xp_furniture:wood_warped": {
				"add": { "component_groups": ["xp_furniture:wood_warped"] },
				"trigger": "xp_furniture:is_interactable"
			},
			"xp_furniture:wood_pale_oak": {
				"add": { "component_groups": ["xp_furniture:wood_pale_oak"] },
				"trigger": "xp_furniture:is_interactable"
			}
		}
	}
}
