{
	"format_version": "1.20.50",
	"minecraft:entity": {
		"description": {
			"identifier": "xp_furniture:cooking_pan",

			"is_summonable": true,

			"properties": {
				"xp_furniture:flipped_side": {
					"type": "bool",
					"client_sync": true,
					"default": false
				},
				"xp_furniture:is_cooking": {
					"type": "bool",
					"client_sync": true,
					"default": false
				},
				"xp_furniture:rotation": {
					"type": "int",
					"client_sync": true,
					"range": [0, 3],
					"default": 0
				}
			}
		},

		"component_groups": {
			"xp_furniture:instant_despawn": {
				"minecraft:instant_despawn": {}
			},

			"xp_furniture:reset_interaction": {
				"minecraft:timer": {
					"time": 0.5,
					"looping": true,
					"time_down_event": {
						"event": "xp_furniture:clear_flip_item",
						"target": "self"
					}
				}
			}
		},

		"components": {
			"minecraft:type_family": {
				"family": [
					"furniture",
					"functional",
					"cooking_pan",
					"inanimate"
				]
			},
			"minecraft:collision_box": {
				"height": 0.0,
				"width": 0.0
			},
			"minecraft:knockback_resistance": {
				"value": 1.0
			},
			"minecraft:health": {
				"min": 100,
				"max": 100,
				"value": 100
			},
			"minecraft:damage_sensor": {
				"triggers": {
					"cause": "all",
					"deals_damage": false
				}
			},
			"minecraft:inventory": {
				"inventory_size": 1,
				"can_be_siphoned_from": true
			},
			"minecraft:equip_item": {},
			"minecraft:behavior.equip_item": {
				"priority": 0
			},
			"minecraft:inside_block_notifier": {
				"block_list": [
					{
						"block": {
							"name": "minecraft:air"
						},
						"entered_block_event": {
							"event": "xp_furniture:instant_despawn",
							"target": "self"
						}
					}
				]
			},
			"minecraft:persistent": {},
			"minecraft:conditional_bandwidth_optimization": {}
		},

		"events": {
			"xp_furniture:instant_despawn": {
				"add": {
					"component_groups": ["xp_furniture:instant_despawn"]
				}
			},

			"xp_furniture:set_init_rotation.north": {
				"set_property": { "xp_furniture:rotation": 2 }
			},
			"xp_furniture:set_init_rotation.south": {
				"set_property": { "xp_furniture:rotation": 0 }
			},
			"xp_furniture:set_init_rotation.west": {
				"set_property": { "xp_furniture:rotation": 1 }
			},
			"xp_furniture:set_init_rotation.east": {
				"set_property": { "xp_furniture:rotation": 3 }
			},

			"xp_furniture:flip_item": {
				"add": {
					"component_groups": ["xp_furniture:reset_interaction"]
				},
				"set_property": {
					"xp_furniture:flipped_side": true
				}
			},
			"xp_furniture:clear_flip_item": {
				"remove": {
					"component_groups": ["xp_furniture:reset_interaction"]
				},
				"set_property": {
					"xp_furniture:flipped_side": false
				}
			}
		}
	}
}
