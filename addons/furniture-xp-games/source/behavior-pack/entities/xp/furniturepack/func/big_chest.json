{
	"format_version": "1.21.90",
	"minecraft:entity": {
		"description": {
			"identifier": "xp_furniture:big_chest",
			"is_summonable": true,
			"is_spawnable": false,

			"scripts": {
				"animate": ["unfishable"]
			},
			"animations": {
				"unfishable": "controller.animation.xp_furniture.unfishable"
			},

			"properties": {
				"xp_furniture:is_interacted_with": {
					"type": "bool",
					"default": false,
					"client_sync": true
				},
				"xp_furniture:is_season": {
					"type": "enum",
					"default": "none",
					"values": ["none", "halloween", "christmas"],
					"client_sync": true
				}
			}
		},

		"component_groups": {
			"xp_furniture:collision_north": {
				"minecraft:custom_hit_test": {
					"hitboxes": [
						{
							"width": 0.8,
							"height": 1.0,
							"pivot": [0, 0.6, 0.2]
						},
						{
							"width": 0.8,
							"height": 1.0,
							"pivot": [0.5, 0.6, 0.2]
						},
						{
							"width": 0.8,
							"height": 1.0,
							"pivot": [1, 0.6, 0.2]
						}
					]
				}
			},
			"xp_furniture:collision_south": {
				"minecraft:custom_hit_test": {
					"hitboxes": [
						{
							"width": 0.8,
							"height": 1.0,
							"pivot": [0, 0.6, -0.2]
						},
						{
							"width": 0.8,
							"height": 1.0,
							"pivot": [-0.5, 0.6, -0.2]
						},
						{
							"width": 0.8,
							"height": 1.0,
							"pivot": [-1, 0.6, -0.2]
						}
					]
				}
			},
			"xp_furniture:collision_west": {
				"minecraft:custom_hit_test": {
					"hitboxes": [
						{
							"width": 0.8,
							"height": 1.0,
							"pivot": [0.2, 0.6, 0]
						},
						{
							"width": 0.8,
							"height": 1.0,
							"pivot": [0.2, 0.6, -0.5]
						},
						{
							"width": 0.8,
							"height": 1.0,
							"pivot": [0.2, 0.6, -1]
						}
					]
				}
			},
			"xp_furniture:collision_east": {
				"minecraft:custom_hit_test": {
					"hitboxes": [
						{
							"width": 0.8,
							"height": 1.0,
							"pivot": [-0.2, 0.6, 0]
						},
						{
							"width": 0.8,
							"height": 1.0,
							"pivot": [-0.2, 0.6, 0.5]
						},
						{
							"width": 0.8,
							"height": 1.0,
							"pivot": [-0.2, 0.6, 1]
						}
					]
				}
			},

			"xp_furniture:instant_despawn": {
				"minecraft:instant_despawn": {}
			}
		},

		"components": {
			"minecraft:fire_immune": {},
			"minecraft:type_family": {
				"family": [
					"furniture",
					"functional",
					"big_chest",
					"block_tile_drops",
					"inanimate",
					"xp_named"
				]
			},
			"minecraft:pushable": {
				"is_pushable": false,
				"is_pushable_by_piston": false
			},
			"minecraft:collision_box": {
				"width": 0.0,
				"height": 0.0
			},
			"minecraft:health": {
				"min": 100,
				"max": 100,
				"value": 100
			},
			"minecraft:spell_effects": {
				"add_effects": [
					{
						"effect": "invisibility",
						"duration": "infinite",
						"amplifier": 1,
						"visible": false
					}
				]
			},
			"minecraft:inventory": {
				"can_be_siphoned_from": true,
				"container_type": "inventory",
				"inventory_size": 27,
				"private": false,
				"restrict_to_owner": false
			},
			"minecraft:loot": {
				"table": "loot_tables/empty.json"
			},

			"minecraft:tamemount": {
				"attempt_temper_mod": 5,
				"feed_text": "",
				"max_temper": 100,
				"min_temper": 0,
				"ride_text": ""
			},
			"minecraft:entity_sensor": {
				"find_players_only": true,
				"subsensors": [
					{
						"event": "xp_furniture:clear_on_interact",
						"cooldown": 0.1,
						"range": [10.0, 10.0],
						"minimum_count": 1,
						"event_filters": {
							"all_of": [
								{
									"test": "bool_property",
									"domain": "xp_furniture:is_interacted_with",
									"subject": "self",
									"value": true
								},
								{
									"test": "is_owner",
									"subject": "other",
									"value": true
								},
								{
									"test": "has_container_open",
									"subject": "other",
									"value": false
								}
							]
						}
					}
				]
			},

			"minecraft:damage_sensor": {
				"triggers": [
					{
						"on_damage": {
							"filters": {
								"all_of": [
									{
										"test": "has_damage",
										"value": "magic"
									},
									{
										"test": "has_damage",
										"operator": "!=",
										"value": "projectile"
									}
								]
							},
							"event": "xp_furniture:instant_despawn",
							"target": "self"
						},
						"damage_multiplier": 100,
						"deals_damage": "yes"
					},
					{
						"cause": "all",
						"deals_damage": "no"
					}
				]
			},

			"minecraft:persistent": {},
			"minecraft:physics": {
				"has_gravity": false,
				"has_collision": false,
				"push_towards_closest_space": false
			},
			"minecraft:nameable": {
				"allow_name_tag_renaming": false
			},
			"minecraft:knockback_resistance": {
				"value": 1
			},
			"minecraft:inside_block_notifier": {
				"block_list": [
					{
						"block": {
							"name": "minecraft:air"
						},
						"entered_block_event": {
							"event": "xp_furniture:despawn",
							"target": "self"
						}
					}
				]
			},
			"minecraft:is_hidden_when_invisible": {},
			"minecraft:conditional_bandwidth_optimization": {},
			"minecraft:renders_when_invisible": {}
		},

		"events": {
			"xp_furniture:tile_entity_spawn.north": {
				"add": { "component_groups": ["xp_furniture:collision_north"] }
			},
			"xp_furniture:tile_entity_spawn.south": {
				"add": { "component_groups": ["xp_furniture:collision_south"] }
			},
			"xp_furniture:tile_entity_spawn.west": {
				"add": { "component_groups": ["xp_furniture:collision_west"] }
			},
			"xp_furniture:tile_entity_spawn.east": {
				"add": { "component_groups": ["xp_furniture:collision_east"] }
			},

			"xp_furniture:despawn": {
				"sequence": [
					{
						"queue_command": {
							"command": "execute rotated as @s run fill ^^^ ^1^1^-1 air destroy"
						}
					},
					{
						"queue_command": {
							"command": "event entity @s xp_furniture:instant_despawn"
						}
					}
				]
			},
			"xp_furniture:instant_despawn": {
				"add": {
					"component_groups": ["xp_furniture:instant_despawn"]
				}
			},

			"xp_furniture:on_interact": {
				"set_property": { "xp_furniture:is_interacted_with": true }
			},
			"xp_furniture:clear_on_interact": {
				"set_property": { "xp_furniture:is_interacted_with": false }
			}
		}
	}
}
