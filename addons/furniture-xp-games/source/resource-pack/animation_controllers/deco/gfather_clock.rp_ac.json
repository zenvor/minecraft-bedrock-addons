{
	"format_version": "1.10.0",
	"animation_controllers": {
		"controller.animation.xp_furniture.grandfather_clock.duck": {
			"initial_state": "idle",
			"states": {
				"idle": {
					"animations": ["duck_idle"],
					"transitions": [
						{
							"active": "q.any(q.time_of_day, 0.0, 0.25, 0.5, 0.75)"
						}
					],
					"blend_via_shortest_path": true,
					"blend_transition": 0
				},

				"active": {
					"animations": ["duck_active"],
					"transitions": [
						{
							"idle": "q.all_animations_finished && !q.any(q.time_of_day, 0.0, 0.25, 0.5, 0.75)"
						}
					],
					"blend_via_shortest_path": true,
					"blend_transition": 0
				}
			}
		}
	}
}
