{
	"format_version": "1.10.0",
	"animation_controllers": {
		"controller.animation.xp_furniture.wind_chimes": {
			"initial_state": "init",
			"states": {
				"init": {
					"transitions": [{ "idle": "1" }]
				},

				"idle": {
					"transitions": [
						{
							"ambience": "q.life_time - v.state_time > v.random_state_time"
						}
					],
					"on_entry": [
						"v.state_time = q.life_time;",
						"v.random_state_time = !q.mark_variant ? Math.random(4, 5) : Math.random(6, 7) + Math.random(1, 3);"
					]
				},

				"ambience": {
					"transitions": [
						{ "ambience.bamboo": "!q.mark_variant" },
						{ "ambience.metal": "q.mark_variant" }
					]
				},
				"ambience.bamboo": {
					"transitions": [{ "idle": "1" }],
					"sound_effects": [{ "effect": "bamboo" }]
				},
				"ambience.metal": {
					"transitions": [{ "idle": "1" }],
					"sound_effects": [{ "effect": "metal" }]
				}
			}
		}
	}
}
