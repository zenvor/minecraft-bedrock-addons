{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "xp_furniture:music",
			"basic_render_parameters": {
				"material": "particles_add",
				"texture": "textures/xp/fpack/particle/xp_sprite"
			}
		},
		"curves": {
			"variable.size1": {
				"type": "bezier",
				"input": "v.particle_age",
				"horizontal_range": "v.particle_lifetime",
				"nodes": [0, 1, 0, 0]
			}
		},
		"components": {
			"minecraft:emitter_rate_instant": {
				"num_particles": 1
			},
			"minecraft:emitter_lifetime_once": {
				"active_time": 0.5
			},
			"minecraft:emitter_shape_point": {
				"direction": ["math.random(1, -1)", -2, "math.random(1, -1)"]
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": "math.random(1.5, 2.5)"
			},
			"minecraft:particle_initial_speed": 1.5,
			"minecraft:particle_motion_dynamic": {
				"linear_acceleration": [
					"math.cos(variable.emitter_age*720)*6*variable.particle_random_4",
					0,
					"math.cos(variable.emitter_age*720)*6*variable.particle_random_4"
				],
				"linear_drag_coefficient": 1
			},
			"minecraft:particle_appearance_billboard": {
				"size": [
					"0.7*variable.particle_random_3*variable.size1",
					"0.7*variable.particle_random_3*variable.size1"
				],
				"facing_camera_mode": "rotate_xyz",
				"uv": {
					"texture_width": 256,
					"texture_height": 256,
					"uv": [
						"192+math.floor(variable.particle_random_2*4)*32",
						240
					],
					"uv_size": [16, 16]
				}
			},
			"minecraft:particle_appearance_tinting": {
				"color": {
					"interpolant": "variable.particle_random_4",
					"gradient": {
						"0.0": "#FFFF0000",
						"0.2": "#FFF4FF00",
						"0.47": "#FF00FF39",
						"0.75": "#FF00E1FF",
						"1.0": "#FF6A00FF"
					}
				}
			}
		}
	}
}
