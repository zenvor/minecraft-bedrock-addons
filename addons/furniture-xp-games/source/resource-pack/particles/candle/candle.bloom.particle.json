				"size": [
					"0.07 + 0.1 * variable.particle_random_2 + 0.1 * math.sin(variable.particle_age / variable.particle_lifetime * 180)",
					"0.13 + 0.1 * variable.particle_random_2 + 0.1 * math.sin(variable.particle_age / variable.particle_lifetime * 180)"
				],
				"facing_camera_mode": "rotate_xyz",
				"uv": {
					"texture_width": 256,
					"texture_height": 256,
					"uv": [
