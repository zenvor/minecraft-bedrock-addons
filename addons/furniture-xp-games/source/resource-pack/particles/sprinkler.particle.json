{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "xp_furniture:sprinkler",
			"basic_render_parameters": {
				"material": "particles_blend",
				"texture": "textures/particle/particles"
			}
		},
		"curves": {
			"variable.colour": {
				"type": "linear",
				"input": "v.particle_age",
				"horizontal_range": "v.particle_lifetime",
				"nodes": [0, 1]
			}
		},
		"components": {
			"minecraft:emitter_rate_steady": {
				"spawn_rate": 20,
				"max_particles": 100
			},
			"minecraft:emitter_lifetime_once": {
				"active_time": 7
			},
			"minecraft:emitter_shape_point": {
				"offset": [0, 0.1, 0],
				"direction": ["v.direction_x ?? 0", -1.5, "v.direction_z ?? 0"]
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": "math.random(1, 2)"
			},
			"minecraft:particle_initial_speed": "math.random(7, 18)",
			"minecraft:particle_motion_dynamic": {
				"linear_acceleration": [0, "-math.Random(1, 4.5)", 0],
				"linear_drag_coefficient": 4
			},
			"minecraft:particle_appearance_billboard": {
				"size": [
					"(0.075*v.particle_random_2+0.02) / (v.particle_age+0.1)",
					"(0.075*v.particle_random_2+0.02) / (v.particle_age+0.3)"
				],
				"facing_camera_mode": "lookat_direction",
				"uv": {
					"texture_width": 128,
					"texture_height": 128,
					"uv": [8, 56],
					"uv_size": [8, 8]
				}
			},
			"minecraft:particle_motion_collision": {
				"collision_drag": 1,
				"coefficient_of_restitution": 1,
				"collision_radius": 0.1
			},
			"minecraft:particle_appearance_lighting": {},
			"minecraft:particle_appearance_tinting": {
				"color": {
					"interpolant": "v.particle_random_3+v.particle_age",
					"gradient": {
						"0.0": "#FF007FFF",
						"2.5": "#B5009FFF",
						"5.0": "#6E00ACFF",
						"6.9": "#8500B8FF",
						"10.0": "#8200A5FF"
					}
				}
			}
		}
	}
}
