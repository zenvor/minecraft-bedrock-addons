{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "xp_furniture:camera_1",
			"basic_render_parameters": {
				"material": "particles_add",
				"texture": "textures/xp/fpack/particle/xp_sprite"
			}
		},
		"curves": {
			"variable.size1": {
				"type": "bezier_chain",
				"input": "v.particle_age/v.particle_lifetime",
				"nodes": {
					"0.0": {
						"value": 0,
						"slope": 2.55
					},
					"1.0": {
						"value": 1,
						"slope": 0
					},
					"0.32": {
						"value": 1,
						"slope": 0
					}
				}
			}
		},
		"components": {
			"minecraft:emitter_rate_instant": {
				"num_particles": 6
			},
			"minecraft:emitter_lifetime_once": {
				"active_time": 1
			},
			"minecraft:emitter_shape_point": {},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": 0.15,
				"expiration_expression": "q.graphics_mode_is_any('deferred')"
			},
			"minecraft:particle_initial_speed": 0,
			"minecraft:particle_motion_dynamic": {},
			"minecraft:particle_appearance_billboard": {
				"size": [
					"0.1/(v.particle_age+0.01)*variable.size1",
					"0.1/(v.particle_age+0.01)*variable.size1"
				],
				"facing_camera_mode": "rotate_xyz",
				"uv": {
					"texture_width": 256,
					"texture_height": 256,
					"uv": [16, 41],
					"uv_size": [16, 16]
				}
			},
			"minecraft:particle_appearance_tinting": {
				"color": {
					"interpolant": "v.particle_age / v.particle_lifetime",
					"gradient": {
						"0.0": "#FFFFFFFF",
						"0.35": "#63FFFFFF",
						"1.0": "#00FFFFFF"
					}
				}
			}
		}
	}
}
