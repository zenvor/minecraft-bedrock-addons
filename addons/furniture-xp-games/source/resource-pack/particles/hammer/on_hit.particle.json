{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "xp_furniture:hammer.on_hit",
			"basic_render_parameters": {
				"material": "particles_alpha",
				"texture": "textures/blocks/planks_oak"
			}
		},
		"curves": {
			"variable.size": {
				"type": "linear",
				"input": "v.particle_age",
				"horizontal_range": "v.particle_lifetime",
				"nodes": [1, 0]
			}
		},
		"components": {
			"minecraft:emitter_rate_instant": {
				"num_particles": "(6 + math.min(v.particle_amount ?? 0, 64)) * 2"
			},
			"minecraft:emitter_lifetime_once": {
				"active_time": 1
			},
			"minecraft:emitter_shape_disc": {
				"offset": [0, 1, 0],
				"radius": 0.75,
				"direction": ["math.random(-0.5,0.5)", -1, "math.random(-0.5,0.5)"]
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": "math.random(1.2, 2.4)*2"
			},
			"minecraft:particle_expire_if_in_blocks": ["minecraft:water"],
			"minecraft:particle_initial_spin": {
				"rotation": "math.random(0, 360)"
			},
			"minecraft:particle_initial_speed": "math.random(16, 32)",
			"minecraft:particle_motion_dynamic": {
				"linear_acceleration": [0, "-math.random(2, 4) * 4", 0],
				"linear_drag_coefficient": "math.random(4, 8) * 0.5"
			},
			"minecraft:particle_appearance_billboard": {
				"size": ["variable.size * variable.particle_random_1 * 0.0375 + 0.0375", "variable.size * variable.particle_random_1 * 0.0375 + 0.0375"],
				"facing_camera_mode": "lookat_xyz",
				"uv": {
					"texture_width": 16,
					"texture_height": 16,
					"uv": ["math.floor(v.particle_random_1 * 14)", "math.floor(v.particle_random_2 * 14)"],
					"uv_size": ["v.particle_random_1 + 2", "v.particle_random_2 + 2"]
				}
			},
			"minecraft:particle_motion_collision": {
				"collision_drag": 1,
				"coefficient_of_restitution": 1,
				"collision_radius": 0.1
			},
			"minecraft:particle_appearance_lighting": {},
			"minecraft:particle_appearance_tinting": {
				"color": [1, 1, 1, 1]
			}
		}
