{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "xp_furniture:block.dust",
			"basic_render_parameters": {
				"material": "particles_blend",
				"texture": "textures/xp/fpack/particle/xp_sprite"
			}
		},
		"curves": {
			"variable.life": {
				"type": "bezier_chain",
				"input": "v.particle_age",
				"nodes": {
					"0.0": {
						"value": 0,
						"slope": 0
					},
					"0.74": {
						"value": 4,
						"slope": 0
					},
					"0.99": {
						"value": -8,
						"slope": 0
					},
					"0.17": {
						"value": 4,
						"slope": 0
					}
				}
			}
		},
		"components": {
			"minecraft:emitter_rate_instant": {
				"num_particles": "math.random_integer(7,13)"
			},
			"minecraft:emitter_lifetime_once": {
				"active_time": 0.65
			},
			"minecraft:emitter_shape_disc": {
				"offset": [0.5, 0.15, 0.5],
				"radius": "0.45+(v.emitter_age*0.8)",
				"surface_only": true,
				"direction": "outwards"
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": "Math.random(0.5,1)"
			},
			"minecraft:particle_initial_spin": {
				"rotation": "math.floor(math.random(0,4))*90"
			},
			"minecraft:particle_initial_speed": "Math.random(0.25,0.5)",
			"minecraft:particle_motion_dynamic": {
				"linear_acceleration": [
					"Math.random(3,-3)",
					"Math.random(-0.1,0.5)",
					"Math.random(3,-3)"
				],
				"linear_drag_coefficient": "Math.random(2,1.25)",
				"rotation_drag_coefficient": 1
			},
			"minecraft:particle_appearance_billboard": {
				"size": [
					"0.1+(v.particle_random_1*0.1)",
					"0.1+(v.particle_random_1*0.1)"
				],
				"facing_camera_mode": "lookat_xyz",
				"uv": {
					"texture_width": 256,
					"texture_height": 256,
					"flipbook": {
						"base_UV": [240, 0],
						"size_UV": [16, 16],
						"step_UV": [0, 16],
						"frames_per_second": 1,
						"max_frame": 9,
						"stretch_to_lifetime": true
					}
				}
			},
			"minecraft:particle_motion_collision": {
				"collision_radius": 0.075
			},
			"minecraft:particle_appearance_lighting": {},
			"minecraft:particle_appearance_tinting": {
				"color": {
					"interpolant": "(v.particle_age)/v.particle_lifetime",
					"gradient": {
						"0.0": "#00FFFFFF",
						"0.12": "#CCF6F3F0",
						"0.43": "#A1EAEAEA",
						"0.72": "#73E0DFDB",
						"1.0": "#00D3D2D2"
					}
				}
			}
		}
	}
}
