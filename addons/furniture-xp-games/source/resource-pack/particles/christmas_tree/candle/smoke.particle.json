{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "xp_furniture:christmas_tree.candle.smoke",
			"basic_render_parameters": {
				"material": "particles_blend",
				"texture": "textures/xp/fpack/particle/xp_sprite"
			}
		},
		"components": {
			"minecraft:emitter_rate_steady": {
				"spawn_rate": "math.random(0,3)",
				"max_particles": 50
			},
			"minecraft:emitter_lifetime_expression": {
				"activation_expression": 1,
				"expiration_expression": "q.is_alive ? (!q.property('xp_furniture:candles') || !q.property('xp_furniture:is_lit')) : 0"
			},
			"minecraft:emitter_shape_sphere": {
				"radius": 0.1,
				"surface_only": true,
				"direction": [0, -1, 0]
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": "math.random(0.7, 1.2)"
			},
			"minecraft:particle_expire_if_in_blocks": [
				"minecraft:water",
				"minecraft:flowing_water"
			],
			"minecraft:particle_initial_speed": 1,
			"minecraft:particle_motion_dynamic": {
				"linear_acceleration": [0, -0.5, 0]
			},
			"minecraft:particle_appearance_billboard": {
				"size": [
					"variable.particle_random_2*0.15",
					"variable.particle_random_2*0.15"
				],
				"facing_camera_mode": "rotate_xyz",
				"uv": {
					"texture_width": 256,
					"texture_height": 256,
					"flipbook": {
						"base_UV": [192, 0],
						"size_UV": [16, 16],
						"step_UV": [0, 16],
						"max_frame": 10,
						"stretch_to_lifetime": true
					}
				}
			},
			"minecraft:particle_appearance_tinting": {
				"color": {
					"interpolant": "v.particle_age / v.particle_lifetime",
					"gradient": {
						"0.0": "#00FF795A",
						"0.68": "#8AD17B43",
						"1.0": "#007E481F"
					}
				}
			}
		}
	}
}
