{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "xp_furniture:blinds.dust.day",
			"basic_render_parameters": {
				"material": "particles_add",
				"texture": "textures/xp/fpack/particle/xp_sprite"
			}
		},
		"components": {
			"minecraft:emitter_rate_steady": {
				"spawn_rate": 1,
				"max_particles": 5
			},
			"minecraft:emitter_lifetime_looping": {
				"active_time": 2
			},
			"minecraft:emitter_shape_box": {
				"offset": [0, 0, -0.45],
				"half_dimensions": [0.35, 1.25, 0.35],
				"direction": "inwards"
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": "math.random(2, 5)"
			},
			"minecraft:particle_initial_speed": "math.random(0.1,0.5)",
			"minecraft:particle_motion_dynamic": {
				"linear_acceleration": [
					"v.particle_random_4 > 0.5 ? math.cos(v.particle_age * 60)*0.2 : -math.cos(v.particle_age * 60)*0.2",
					"v.particle_random_4 > 0.5 ? math.cos(v.particle_age * 60)*0.2 : -math.cos(v.particle_age * 60)*0.2",
					"v.particle_random_4 > 0.5 ? math.sin(v.particle_age * 60)*0.2 : -math.sin(v.particle_age * 60)*0.2"
				],
				"linear_drag_coefficient": 2
			},
			"minecraft:particle_appearance_billboard": {
				"size": [
					"0.4 * v.particle_random_1",
					"0.4 * v.particle_random_1"
				],
				"facing_camera_mode": "rotate_xyz",
				"uv": {
					"texture_width": 256,
					"texture_height": 256,
					"uv": [0, 66],
					"uv_size": [32, 32]
				}
			},
			"minecraft:particle_appearance_tinting": {
				"color": {
					"interpolant": "v.particle_age / v.particle_lifetime",
					"gradient": {
						"0.0": "#00B7946C",
						"0.41": "#69E8B656",
						"1.0": "#00000000"
					}
				}
			}
		}
	}
}
