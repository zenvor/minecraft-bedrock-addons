{
	"format_version": "1.10.0",
	"minecraft:attachable": {
		"description": {
			"identifier": "xp_furniture:watering_can",
			"materials": {
				"default": "entity_alphatest"
			},
			"textures": {
				"default": "textures/xp/fpack/entity/func/watering_can_static"
			},
			"scripts": {
				"parent_setup": "v.is_using_watering_can = 1;",
				"animate": [
					{ "wield_fp": "c.is_first_person" },
					{ "wield_tp": "!c.is_first_person" },
					//"use_controller"
					{ "interact": "c.owning_entity -> v.is_using_watering_can" }
				]
			},
			"animations": {
				"wield_fp": "animation.xp_furniture.watering_can.wield_fp",
				"wield_tp": "animation.xp_furniture.watering_can.wield_tp",

				"use_controller": "controller.animation.xp_furniture.watering_can",
				"interact": "animation.xp_furniture.watering_can.use"
			},
			"geometry": {
				"default": "geometry.xp_furniture.watering_can_in_hand"
			},
			"render_controllers": ["controller.render.xp_furniture.default"]
		}
	}
}
