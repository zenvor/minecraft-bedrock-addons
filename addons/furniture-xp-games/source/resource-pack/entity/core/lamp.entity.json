{
	"format_version": "1.10.0",
	"minecraft:client_entity": {
		"description": {
			"identifier": "xp_furniture:lamp",
			"materials": {
				"default": "entity_alphatest",
				"lit": "entity_emissive",
				"glow": "entity_beam_additive"
			},
			"textures": {
				"default": "textures/xp/fpack/entity/core/lamp/lamp_compressed"
			},
			"geometry": {
				"vfx": "geometry.xp_furniture.lamp.vfx"
			},
			"scripts": {
				"animate": [
					"align",
					{
						"glow": "q.property('xp_furniture:is_interacted_with') || q.property('xp_furniture:is_uninteractable')"
					},
					"sounds"
				],
				"should_update_bones_and_effects_offscreen": true
			},
			"animations": {
				"align": "animation.xp_furniture.lamp.align",
				"glow": "animation.xp_furniture.lamp.glow",
				"sounds": "controller.animation.xp_furniture.lamp"
			},
			"particle_effects": {
				"light": "xp_furniture:lamp_light",
				"dust": "xp_furniture:lamp_light.dust"
			},
			"sound_effects": {
				"on": "xp_furniture:lamp.on",
				"off": "xp_furniture:lamp.off"
			},
			"render_controllers": [
				"controller.render.xp_furniture.lamp.emissive",
				"controller.render.xp_furniture.lamp.glow"
			]
		}
	}
}
