{
	"format_version": "1.8.0",
	"render_controllers": {
		"controller.render.xp_furniture.lamp": {
			"arrays": {
				"geometries": {
					"Array.wood_variants": [
						"Geometry.oak",
						"Geometry.acacia",
						"Geometry.bamboo",
						"Geometry.birch",
						"Geometry.cherry",
						"Geometry.crimson",
						"Geometry.dark_oak",
						"Geometry.jungle",
						"Geometry.mangrove",
						"Geometry.spruce",
						"Geometry.template",
						"Geometry.warped"
					]
				}
			},

			"geometry": "Array.wood_variants[q.mark_variant]",
			"materials": [
				{ "*": "Material.default" },
				{ "emissive": "Material.lit" }
			],
			"textures": [
				"!q.property('xp_furniture:is_uninteractable') ? Texture.default : Texture.none"
			],
			"is_hurt_color": {},
			"on_fire_color": {}
		},

		"controller.render.xp_furniture.lamp.unlit": {
			"arrays": {
				"geometries": {
					"Array.wood_variants": [
						"Geometry.oak",
						"Geometry.acacia",
						"Geometry.bamboo",
						"Geometry.birch",
						"Geometry.cherry",
						"Geometry.crimson",
						"Geometry.dark_oak",
						"Geometry.jungle",
						"Geometry.mangrove",
						"Geometry.spruce",
						"Geometry.template",
						"Geometry.warped"
					]
				}
			},

			"geometry": "Array.wood_variants[q.mark_variant]",
			"materials": [
				{ "*": "Material.default" },
				{ "emissive": "Material.unlit" }
			],
			"textures": [
				"!q.property('xp_furniture:is_uninteractable') ? Texture.default : Texture.none"
			],
			"ignore_lighting": true,
			"is_hurt_color": {},
			"on_fire_color": {}
		},

		"controller.render.xp_furniture.lamp.emissive": {
			"geometry": "Geometry.vfx",
			"materials": [{ "*": "Material.lit" }],
			"textures": ["Texture.default"],
			"ignore_lighting": true,

			"part_visibility": [{ "*": false }, { "emissive": true }]
		},
		"controller.render.xp_furniture.lamp.glow": {
			"geometry": "Geometry.vfx",
			"materials": [{ "*": "Material.glow" }],
			"textures": ["Texture.default"],
			"ignore_lighting": true,

			"part_visibility": [{ "*": false }, { "glow": true }]
		}
	}
}
