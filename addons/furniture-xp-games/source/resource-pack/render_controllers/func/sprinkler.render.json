{
	"format_version": "1.8.0",
	"render_controllers": {
		"controller.render.xp_furniture.sprinkler.base": {
			"geometry": "Geometry.default",
			"materials": [{ "*": "Material.base" }],
			"textures": ["Texture.default"],
