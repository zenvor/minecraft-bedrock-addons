{
	"format_version": "1.8.0",
	"render_controllers": {
		"controller.render.xp_furniture.big_cauldron.base": {
			"arrays": {
				"textures": {
					"Array.texture_type": [
						"Texture.black",
						"Texture.copper",
						"Texture.gray"
					]
				}
			},
			"geometry": "Geometry.default",
			"materials": [{ "*": "Material.uv_anim" }],
			"textures": ["Array.texture_type[q.variant]"],
			"is_hurt_color": {},
			"on_fire_color": {},
			"uv_anim": {
				"offset": [0.0, "math.mod(math.floor(q.life_time * 4), 4) / 4"],
				"scale": [1.0, "1 / 4"]
			},

			"part_visibility": [
				{ "*": "!q.property('xp_furniture:is_uninteractable')" },
				{ "spoon": true },
				{ "water": false }
			]
		},
		"controller.render.xp_furniture.big_cauldron.liquid": {
			"geometry": "Geometry.default",
			"materials": [
				{
					"*": "!q.property('xp_furniture:has_already_brewed') ? Material.uv_anim_blend : Material.uv_anim"
				}
			],
			"textures": [
				"!q.property('xp_furniture:has_already_brewed') ? Texture.liquid_water : ((q.property('xp_furniture:is_season') == 'none' ? Texture.liquid_potion : Texture.liquid_potion_spooky))"
			],
			"is_hurt_color": {},
			"on_fire_color": {},
			"uv_anim": {
				"offset": [0.0, "math.mod(math.floor(q.life_time * 4), 4) / 4"],
				"scale": [1.0, "1 / 4"]
			},

			"part_visibility": [
				{ "*": false },
				{
					"water": "q.property('xp_furniture:is_uninteractable') ? q.property('xp_furniture:potion_fullness') > 0 : true"
				}
			]
		}
	}
}
