{"format_version":"1.12.0","minecraft:client_entity":{"description":{"identifier":"spark_vfx:lens_flare","render_controllers":[{"controller.render.spark_vfx.lens_flare":"Math.sqrt(Math.pow(v.distance_x, 2)  +  0.64 * Math.pow(v.distance_y, 2)) < 60 && (  Math.abs( Math.mod(q.rotation_to_camera(1) + 360+45, 90)-45 ) * (1-math.exp((q.rotation_to_camera(0)-90) / 10)) < 2  ) && (Math.abs(v.inversion_multiplier) < 0.5 || q.camera_rotation(0) < -50)"},{"controller.render.spark_vfx.lens_flare_light":"q.property('spark_vfx:variant') == 1"}],"materials":{"default":"spark_vfx.lens_flare","light":"spark_vfx.lens_flare_light"},"textures":{"day":"textures/spark/vfx/entity/lens_flare/day","sunset":"textures/spark/vfx/entity/lens_flare/sunset","moon":"textures/spark/vfx/entity/lens_flare/moon","sunset_light":"textures/spark/vfx/entity/lens_flare/sunset_light"},"geometry":{"default":"geometry.spark_vfx.lens_flare","light":"geometry.spark_vfx.lens_flare_light"},"animations":{"state":"animation.spark_vfx.lens_flare.state"},"scripts":{"scale":"q.property('spark_vfx:visible') ? 3 : 0","pre_animation":["v.opacity = q.property('spark_vfx:opacity');","v.angle_y = Math.mod(q.camera_rotation(1)-q.rotation_to_camera(1) + 720, 360) - 180;","v.inversion_multiplier = math.lerp(math.pow(v.angle_y / 180, 3), v.angle_y/180, Math.abs(math.sin(q.rotation_to_camera(0))) );","v.distance_x = Math.mod(q.camera_rotation(0)+q.rotation_to_camera(0)+540, 360) - 180;","v.distance_y = Math.mod(q.camera_rotation(1)+q.rotation_to_camera(1)+540, 360) - 180;","v.distance_y = (Math.abs(v.distance_y) > 90 ? (-v.distance_y + 180 * (v.distance_y>0?1:-1) ) : v.distance_y) * (1-math.exp((q.rotation_to_camera(0)-90) / 10));"],"animate":[{"state":1}]}}}}